<mxfile host="drawio" version="24.7.17" type="device"><diagram id="p00" name="00 封面与图例"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p00-1" value="yanshi 分布式 Agent 运行时 —— 架构评审图集" style="text;html=1;whiteSpace=wrap;fontSize=28;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="50" as="geometry"/></mxCell><mxCell id="p00-2" value="依据：章程（docs/charter.md）、术语表（CONTEXT.md）、设计文档（docs/design）、ADR-0001～0051 · 2026-10-31 · 按需求与架构思路重新整理，体现整体思想与关键设计，不逐一对应当前代码" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1520" height="26" as="geometry"/></mxCell><mxCell id="p00-3" value="目录与阅读顺序：L0 → L1 → L2 → 专题 → 场景 → 业务线示例" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=15;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="900" height="900" as="geometry"/></mxCell><mxCell id="p00-4" value="01" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-5" value="&lt;b&gt;L0 系统上下文&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="165" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-6" value="yanshi 是什么、为谁服务、依赖哪些外部系统" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="165" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-7" value="02" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="225" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-8" value="&lt;b&gt;L1 分层架构总览&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="225" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-9" value="由哪些部分组成、怎样分层、哪些关注点贯穿各层" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="225" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-10" value="03" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="285" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-11" value="&lt;b&gt;L2 内核组件视图&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="285" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-12" value="每层内部有哪些组件、按进程角色怎样组合" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="285" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-13" value="04" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-14" value="&lt;b&gt;三层边界：内核 / Persona / 应用&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="345" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-15" value="什么放进内核、什么留给业务侧" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="345" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-16" value="05" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="405" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-17" value="&lt;b&gt;执行内核：Event 日志为唯一事实源&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="405" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-18" value="为什么服务端无状态、故障不丢进度" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="405" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-19" value="06" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-20" value="&lt;b&gt;Run 生命周期&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="465" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-21" value="长任务怎样挂起、恢复、中断、接管" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="465" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-22" value="07" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="525" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-23" value="&lt;b&gt;端云协同：设备即节点与能力路由&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="525" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-24" value="设备、沙箱、MCP、三方 Agent 怎样统一接入" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="525" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-25" value="08" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="585" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-26" value="&lt;b&gt;信任边界与安全检查点&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="585" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-27" value="不可信内容怎样被挡住、不能借路提升权限" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="585" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-28" value="09" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="645" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-29" value="&lt;b&gt;部署拓扑&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="645" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-30" value="生产怎么部署、按什么拆进程、怎样扩容" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="645" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-31" value="10" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="705" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-32" value="&lt;b&gt;数据归属、分片与生命周期&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="705" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-33" value="数据存在哪、按什么分片、怎样删干净" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="705" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-34" value="11" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="765" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-35" value="&lt;b&gt;北极星场景 A：跨端长任务时序&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="765" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-36" value="一次请求怎样把上述机制串起来" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="765" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-37" value="12" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="825" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-38" value="&lt;b&gt;示例业务线：xinli&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="116" y="825" width="330" height="50" as="geometry"/></mxCell><mxCell id="p00-39" value="业务线怎样只经公开契约在内核之上搭建产品" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#333333;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="825" width="470" height="50" as="geometry"/></mxCell><mxCell id="p00-40" value="13" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=16;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="48" height="50" as="geometry"/></mxCell><mxCell id="p00-41" value="&lt;b&gt;通用性风险&