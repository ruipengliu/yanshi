height="30" as="geometry"/></mxCell><mxCell id="p14-61" value="内置 + 外部 Loop（ADR-0041 落地）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="174" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-62" value="Memory 召回" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1210" y="204" width="230" height="30" as="geometry"/></mxCell><mxCell id="p14-63" value="内置的上下文提供者" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="204" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-64" value="attests_speakers · speaker_ref" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1210" y="234" width="230" height="30" as="geometry"/></mxCell><mxCell id="p14-65" value="结构化来源契约" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="234" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-66" value="擦除 = 删除工作 Session" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1210" y="264" width="230" height="30" as="geometry"/></mxCell><mxCell id="p14-67" value="按删除粒度切分 Session（通用模式）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="264" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-68" value="Redo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1210" y="294" width="230" height="30" as="geometry"/></mxCell><mxCell id="p14-69" value="Session 分叉" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="294" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-70" value="ask_user · 审批" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1210" y="324" width="230" height="30" as="geometry"/></mxCell><mxCell id="p14-71" value="路由给&quot;人&quot;的调用之一" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="324" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-72" value="Session 属于一个 EndUser" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1210" y="354" width="230" height="30" as="geometry"/></mxCell><mxCell id="p14-73" value="Session 有参与者集合" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="354" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-74" value="Schedule · Outbox · Oneshot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1210" y="384" width="230" height="30" as="geometry"/></mxCell><mxCell id="p14-75" value="保持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1440" y="384" width="320" height="30" as="geometry"/></mxCell><mxCell id="p14-76" value="&lt;b&gt;保留（实线部分）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;Event 日志唯一事实源 · decide–commit · Attempt fencing&lt;br&gt;设备即节点 · 统一能力路由 · call_id 去重&lt;br&gt;来源由平台推导 · 检查点平台独占&lt;br&gt;删除优先 · 分片键只取 Session / EndUser&lt;br&gt;评测与模拟是裁判 · 模块化单体按角色拆进程&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1210" y="430" width="550" height="150" as="geometry"/></mxCell><mxCell id="p14-77" value="&lt;b&gt;演进路径&lt;/b&gt;（由第二条业务线驱动，不一次做全）" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1210" y="598" width="550" height="24" as="geometry"/></mxCell><mxCell id="p14-78" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="634" width="22" height="22" as="geometry"/></mxCell><mxCell id="p14-79" value="&lt;b&gt;上下文提供者 · 改判&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;需求频率最高，堵住&quot;塞进输入&quot;的洗白绕法；要写新 ADR 改判 ADR-0043 的&quot;不自动注入&quot;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1240" y="628" width="520" height="56" as="geometry"/></mxCell><mxCell id="p14-80" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="698" width="22" height="22" as="geometry"/></mxCell><mxCell id="p14-81" value="&lt;b&gt;结构化来源契约 · 新提议&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;吸收 attests_speakers、speaker_ref；须在第二条业务线接入前完成&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1240" y="692" width="520" height="56" as="geometry"/></mxCell><mxCell id="p14-82" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="762" width="22" height="22" as="geometry"/></mxCell><mxCell id="p14-83" value="&lt;b&gt;落地外部 Loop · 已定未实现&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;ADR-0041 第 3 步；B 端确定接入时做；超时与重复请求进模拟测试&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1240" y="756" width="520" height="56" as="geometry"/></mxCell><mxCell id="p14-84" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="826" width="22" height="22" as="geometry"/></mxCell><mxCell id="p14-85" value="&lt;b&gt;策略叠加 · 新提议&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;与第 3 步一起做&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1240" y="820" width="520" height="56" as="geometry"/></mxCell><mxCell id="p14-86" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="890" width="22" height="22" as="geometry"/></mxCell><mxCell id="p14-87" value="&lt;b&gt;多参与者 Session 与坐席 · 新提议&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;确有群聊、客服场景时才做；先写 ADR 定删除语义&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1240" y="884" width="520" height="56" as="geometry"/></mxCell><mxCell id="p14-88" value="&lt;b&gt;代价与取舍&lt;/b&gt;：每一项都扩大内核要验证的面 ——&lt;br&gt;· 外部 Loop：每步一次往返、第一版不流式；完整上下文离开平台，业务线承担保留与删除义务（ADR-0041）&lt;br&gt;· 上下文提供者：增加 Run 启动延迟，是新的外部依赖，须有超时、失败走默认路径，结果进评测&lt;br&gt;· 多参与者 Session：一人注销时，其在群 Session 中的发言怎样删除&lt;br&gt;· 更细的删除粒度：加密销毁要求与备份隔离的密钥存储，私有化不一定有 KMS（ADR-0015 否决它的理由）" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1012" width="1140" height="110" as="geometry"/></mxCell><mxCell id="p14-89" value="&lt;b&gt;评审要讨论的问题&lt;/b&gt;&lt;br&gt;① 第二条业务线是什么？它决定第 3、5 步的时机&lt;br&gt;② 是否改判 ADR-0043 的&quot;不自动注入&quot;&lt;br&gt;③ 外部 Loop 之外，是否还需要轻量的声明式分支（ADR-0041 已否决 YAML 工作流）&lt;br&gt;④ 删除粒度停在 Session，还是为更细粒度引入密钥管理" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1210" y="966" width="550" height="156" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
