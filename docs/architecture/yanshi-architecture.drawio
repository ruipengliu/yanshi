pacing=2;" vertex="1" parent="1"><mxGeometry x="1132" y="614" width="400" height="28" as="geometry"/></mxCell><mxCell id="p00-71" value="" style="edgeStyle=none;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="666" as="sourcePoint"/><mxPoint x="1120" y="666" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p00-72" value="异步：事件、拉取、唤醒、回调" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1132" y="652" width="400" height="28" as="geometry"/></mxCell><mxCell id="p00-73" value="" style="edgeStyle=none;startArrow=block;startFill=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="704" as="sourcePoint"/><mxPoint x="1120" y="704" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p00-74" value="双向长连接" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1132" y="690" width="400" height="28" as="geometry"/></mxCell><mxCell id="p00-75" value="&lt;b&gt;标注&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1000" y="732" width="540" height="24" as="geometry"/></mxCell><mxCell id="p00-76" value="关键约束 / 不变量" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="764" width="200" height="56" as="geometry"/></mxCell><mxCell id="p00-77" value="灰色小字 &lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;ADR-0004&lt;/span&gt; 指向 docs/adr 中对应的决策记录，供评审追溯理由" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1214" y="764" width="330" height="56" as="geometry"/></mxCell><mxCell id="p00-78" value="信任区" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcf0f0;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#b85450;strokeWidth=1.5;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="836" width="160" height="50" as="geometry"/></mxCell><mxCell id="p00-79" value="红色虚线区：信任边界（第 08 页）；数字圆点：流程步骤序号" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1172" y="836" width="370" height="50" as="geometry"/></mxCell><mxCell id="p00-80" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1172" y="898" width="22" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p01" name="01 L0 系统上下文"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p01-1" value="&lt;b&gt;L0 系统上下文&lt;/b&gt;　谁使用 yanshi、它依赖谁" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="500" height="40" as="geometry"/></mxCell><mxCell id="p01-2" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;strokeWidth=3;fillColor=#f0f7ef;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="480" height="330" as="geometry"/></mxCell><mxCell id="p01-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;yanshi&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;分布式 Agent 运行时基础设施&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;业务线只定义&quot;Agent 做什么&quot;；yanshi 负责 Agent 在云、手机、电脑之间&lt;br&gt;长时间、可靠、安全、低成本地运行&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="580" y="312" width="440" height="120" as="geometry"/></mxCell><mxCell id="p01-4" value="G1 多端接续" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-5" value="G2 多模态 · Call" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="730" y="450" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-6" value="G3 小时级长任务" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="880" y="450" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-7" value="G4 个性化 Memory" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="580" y="492" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-8" value="G5 工具与沙箱执行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="730" y="492" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-9" value="G6 低延迟问答" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="880" y="492" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-10" value="G7 无状态线性扩容" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="580" y="534" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-11" value="G8 声明式接入" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="730" y="534" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-12" value="G9 模型中立" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="880" y="534" width="140" height="32" as="geometry"/></mxCell><mxCell id="p01-13" value="&lt;span style=&quot;font-size:12px;color:#2e5e2b&quot;&gt;每条业务线一个单元 · 私有化自托管 · 单二进制可运行全部角色&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="580" y="576" width="440" height="40" as="geometry"/></mxCell><mxCell id="p01-14" value="EndUser&lt;br&gt;终端用户" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="66" y="350" width="30" height="56" as="geometry"/></mxCell><mxCell id="p01-15" value="&lt;b&gt;Device · HostApp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;手机 / 电脑 / 网页中嵌入端侧 SDK 的业务 App&lt;br&gt;· 会话客户端：输入、插话、中断、审批、回答&lt;br&gt;· Node：声明并执行本地 Capability&lt;br&gt;· Call：全双工语音&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="300" height="160" as="geometry"/></mxCell><mxCell id="p01-16" value="领夹等外设只经 HostApp 接入，不是 Device" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="300" height="36" as="geometry"/></mxCell><mxCell id="p01-17" value="" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;startFill=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.24;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01-15" target="p01-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01-18" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;Connection（WebSocket）&lt;br&gt;HTTP / SSE&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="424" y="330" width="134" height="44" as="geometry"/></mxCell><mxCell id="p01-19" value="&lt;b&gt;研发与运营&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;调试控制台（脚本化模型、验证场景）&lt;br&gt;评测 make eval（固定用例 + 基线）&lt;br&gt;确定性模拟 make sim · 主备切换演练&lt;br&gt;故障注入 serve -faults&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="360" height="130" as="geometry"/></mxCell><mxCell id="p01-20" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize