1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01-2" target="p01-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01-36" value="&lt;b&gt;推送通道（规划）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;APNs / FCM；当前为桩，载荷只含种类与 ID&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1180" y="500" width="340" height="88" as="geometry"/></mxCell><mxCell id="p01-37" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;strokeColor=#999999;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01-2" target="p01-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01-38" value="&lt;b&gt;三方 Agent（规划）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;A2A 出站：办事；入站：问询&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0048&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1180" y="600" width="340" height="88" as="geometry"/></mxCell><mxCell id="p01-39" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;strokeColor=#999999;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01-2" target="p01-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01-40" value="外联只有上述几项，按 ADR-0001 在部署清单中显式列出、可关闭或替换；网络策略默认禁止其他出网" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1180" y="700" width="340" height="70" as="geometry"/></mxCell><mxCell id="p01-41" value="基础设施（自托管、可插拔，不重造）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="690" width="840" height="120" as="geometry"/></mxCell><mxCell id="p01-42" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;主 + 同步备 × 分片&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0007&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="315" y="722" width="195" height="76" as="geometry"/></mxCell><mxCell id="p01-43" value="&lt;b&gt;S3 兼容对象存储&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;工件 · 工作区归档&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0011&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="520" y="722" width="195" height="76" as="geometry"/></mxCell><mxCell id="p01-44" value="&lt;b&gt;Kubernetes + gVisor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;沙箱独占节点池&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0010&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="725" y="722" width="195" height="76" as="geometry"/></mxCell><mxCell id="p01-45" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;指标只含 ID&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="930" y="722" width="195" height="76" as="geometry"/></mxCell><mxCell id="p01-46" value="按 Session / EndUser 键路由" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01-2" target="p01-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01-47" value="&lt;b&gt;关键约束&lt;/b&gt;：私有化部署，可在无外网 K8s 运行（ADR-0001）· 规模未知 → 必须线性扩容 · 服务端 Go · 主要由 AI Agent 开发 → 契约先行、可验证性第一 · C 端合规（内容安全、个人信息保护）是基座能力&lt;br&gt;&lt;b&gt;非目标&lt;/b&gt;：不训练模型、不自研推理引擎 · 不做具体业务应用（只给参考实现）· 不重造数据库、消息系统、对象存储、容器编排 · 端侧不预设大模型" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1520" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p02" name="02 L1 分层架构总览"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p02-1" value="&lt;b&gt;L1 分层架构总览&lt;/b&gt;　五层 + 两条竖向贯穿的关注点" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1620" height="36" as="geometry"/></mxCell><m