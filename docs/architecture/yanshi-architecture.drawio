ight="78" as="geometry"/></mxCell><mxCell id="p02-76" value="&lt;b&gt;保留与删除&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;物理删除 · 删除屏障&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0015&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1300" y="788" width="170" height="78" as="geometry"/></mxCell><mxCell id="p02-77" value="&lt;b&gt;业务线单元隔离&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;一条业务线一个单元&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1300" y="875" width="170" height="78" as="geometry"/></mxCell><mxCell id="p02-78" value="质量保障（贯穿）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fffaeb;strokeColor=#d6b656;verticalAlign=top;align=center;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1490" y="60" width="190" height="910" as="geometry"/></mxCell><mxCell id="p02-79" value="&lt;b&gt;契约先行&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;proto/ IDL · buf breaking&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0006&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1500" y="92" width="170" height="88" as="geometry"/></mxCell><mxCell id="p02-80" value="&lt;b&gt;确定性模拟&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;internal/sim · 种子可复现&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align