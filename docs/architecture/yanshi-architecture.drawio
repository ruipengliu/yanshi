80" value="&lt;b&gt;⑤ 完成与通知&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#1f4e79;fillColor=#ffffff;spacing=2;" vertex="1" parent="1"><mxGeometry x="44" y="1284" width="300" height="24" as="geometry"/></mxCell><mxCell id="p11-81" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1334" as="sourcePoint"/><mxPoint x="890" y="1334" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11-82" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;模型调用：总结结果&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="615.0" y="1314" width="360" height="18" as="geometry"/></mxCell><mxCell id="p11-83" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1370" as="sourcePoint"/><mxPoint x="510" y="1370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11-84" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;AssistantMessage + RunCompleted（同批追加）&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="425.0" y="1350" width="360" height="18" as="geometry"/></mxCell><mxCell id="p11-85" value="" style="edgeStyle=none;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1406" as="sourcePoint"/><mxPoint x="320" y="1406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11-86" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;事件流推送（订阅者按 seq 续传）&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="235.0" y="1386" width="360" height="18" as="geometry"/></mxCell><mxCell id="p11-87" value="" style="edgeStyle=none;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="1442" as="sourcePoint"/><mxPoint x="130" y="1442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11-88" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;结果；离线时经推送提醒&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fillColor=#ffffff;spacing=0;" vertex="1" parent="1"><mxGeometry x="45.0" y="1422" width="360" height="18" as="geometry"/></mxCell><mxCell id="p11-89" value="&lt;b&gt;随时追问进度&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;用户追加输入成为插话 Steered，不打断 Run，下一次模型调用可见&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="40" y="1498" width="422" height="90" as="geometry"/></mxCell><mxCell id="p11-90" value="&lt;b&gt;Worker 崩溃&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;租约过期后任意 Worker 以新 Attempt 接管；日志 fencing 让旧 Attempt 写不进去&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="472" y="1498" width="422" height="90" as="geometry"/></mxCell><mxCell id="p11-91" value="&lt;b&gt;手机断线重连&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按最后的 seq 续传；晚加入者补齐当前 Run 的实时增量&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="904" y="1498" width="422" height="90" as="geometry"/></mxCell><mxCell id="p11-92" value="&lt;b&gt;覆盖的机制&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;第 05 页日志与唤醒 · 第 06 页挂起与恢复 · 第 07 页可靠投递 · 第 08 页检查点与审批&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1336" y="1498" width="422" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="12 示例业务线：xinli"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1640" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p12-1" value="&lt;b&gt;示例业务线：xinli（心力）&lt;/b&gt;　以录音为入口的个人助手：记录、回忆、跟进事务、反思成长 —— 全部在内核之外搭建，只经公开契约使用内核" style="text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="36" as="geometry"/></mxCell><mxCell id="p12-2" value="&lt;b&gt;HostApp（手机）+ 领夹&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;领夹经蓝牙，不是 Device；产品客户端只持 BFF 凭据&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="64" as="geometry"/></mxCell><mxCell id="p12-3" value="&lt;b&gt;第三方渠道（规划）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;微信 / 飞书；审批一律回到 App&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="300" height="64" as="geometry"/></mxCell><mxCell id="p12-4" value="&lt;b&gt;三方 AI（规划）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;经 Persona 对外 MCP：只读 + 提议写入，不含原文&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1430" y="60" width="330" height="64" as="geometry"/></mxCell><mxCell id="p12-5" value="xinli 应用层（apps/xinli）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1720" height="250" as="geometry"/></mxCell><mxCell id="p12-6" value="&lt;b&gt;采集&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;有序采集会话 · 同 capture_id 重交&lt;br&gt;采集世代：擦除后拒收旧请求&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="186" width="330" height="92" as="geometry"/></mxCell><mxCell id="p12-7" value="&lt;b&gt;识别适配&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;确定性 fake；真实 ASR / 声纹（规划）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="395" y="186" width="330" height="92" as="geometry"/></mxCell><mxCell id="p12-8" value="&lt;b&gt;账号 · 设备 · 权益&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;权益变化 → 持久任务同步内核档位&lt;br&gt;注销：先封入口，再逐库清理&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="735" y="186" width="330" height="92" as="geometry"/></mxCell><mxCell id="p12-9" value="&lt;b&gt;BFF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;产品唯一入口：逐次校验 owner&lt;br&gt;拒绝绕过编排的输入与定时&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1075" y="186" width="330" height="92" as="geometry"/></mxCell><mxCell id="p12-10" value="&lt;b&gt;渠道适配&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;入站 → 问答线程；出站消费回复&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1415" y="186" width="330" height="92" as="geometry"/></mxCell><mxCell id="p12-11" value="&lt;b&gt;应用库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;账号 · 任务 · 收件箱&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="215" y="296" width="160" height="88" as="geometry"/></mxCell><mxCell id="p12-12" value="&lt;b&gt;自动调度&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;白天静默 5 分钟 · 日终 18:00 后静默 2 h 或 04:00 · 周日 23:00&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="395" y="290" width="330" height="96" as="geometry"/></mxCell><mxCell id="p12-13" value="&lt;b&gt;推送&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;唯一实际发送方；载荷只含种类、ID、深链&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="735" y="290" width="330" height="96" as="geometry"/></mxCell><mxCell id="p12-14" value="&lt;b&gt;编排器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;Persona 领域变化 → 编排任务&lt;br&gt;按（事实版本, 操作, 目标）去重 · 租约 · 退避&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1075" y="290" width="330" height="96" as="geometry"/></mxCell><mxCell id="p12-15" value="&lt;b&gt;出站消费&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每分片游标长轮询 · 至少一次 · 恢复对账&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1415" y="290" width="330" height="96" as="geometry"/></mxCell><mxCell id="p12-16" value="Persona 层（persona/）—— 独立 PostgreSQL，按 (业务线, EndUser) 分片" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1000" height="360" as="geometry"/></mxCell><mxCell id="p12-17" value="&lt;b&gt;原文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按业务日 · 批次；引用 &amp;lt;批次&amp;gt;.&amp;lt;段号&amp;gt;&lt;br&gt;次日 0 点后 7 天到期，不延长&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="476" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-18" value="&lt;b&gt;变更集账本&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;有效变更集按稳定顺序叠加&lt;br&gt;用户改动优先 · rev 乐观并发&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="299" y="476" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-19" value="&lt;b&gt;交谈 · 时段&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按停顿切出的连续旁听&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="543" y="476" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-20" value="&lt;b&gt;处理进度 · 领域变化 · 删除待办&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;与接受的变更集同一事务提交&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="787" y="476" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-21" value="&lt;b&gt;项目 · 日总览 · 周回顾&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;直接事实&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="578" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-22" value="&lt;b&gt;实体 · 关注项 · 目标 · 词库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;人、组织、概念、事件；带别名&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="299" y="578" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-23" value="&lt;b&gt;依据索引 Lineage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;问答引用来源；擦除时级联删除&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="543" y="578" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-24" value="&lt;b&gt;承诺账本&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;对方引用实体&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="787" y="578" width="236" height="92" as="geometry"/></mxCell><mxCell id="p12-25" value="&lt;b&gt;MCP 工具（内核调用）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;captures · file_changes · day_ledger · file_day&lt;br&gt;find_related · update_commitments ……&lt;br&gt;只读工具登记为只读&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="316" height="96" as="geometry"/></mxCell><mxCell id="p12-26" value="&lt;b&gt;查询与改动 API（BFF 调用）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;项目、待办、实体、日周总览、原文；用户改动记为作者为用户的变更集&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="381" y="690" width="316" height="96" as="geometry"/></mxCell><mxCell id="p12-27" value="&lt;b&gt;对外 MCP（规划）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;OAuth 范围授权；三方只读，写入只进&quot;待确认&quot;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="707" y="690" width="318" height="96" as="geometry"/></mxCell><mxCell id="p12-28" value="&lt;b&gt;实况预览&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;BFF 读 Persona 最近原文 → 单次调用（无 Session，照常计量、配额、内容安全）；以 capture_revision 拒绝过时结果&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1190" y="520" width="260" height="200" as="geometry"/></mxCell><mxCell id="p12-29" value="&lt;b&gt;定时执行&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;&quot;每周五五点给我周报&quot;：Agent 在问答线程中创建定时 → 到期以平台来源开启 Run → Persona 查询 → 出站流 → 推送&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1510" y="520" width="250" height="200" as="geometry"/></mxCell><mxCell id="p12-30" value="yanshi 内核 —— 只看到 Session、Run、可信页、定时、出站流；不认识交谈、承诺、项目" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f7ef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1720" height="290" as="geometry"/></mxCell><mxCell id="p12-31" value="xinli 的 Session（AgentDef 在 agents/xinli-*.yaml）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f7ef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="55" y="876" width="1060" height="236" as="geometry"/></mxCell><mxCell id="p12-32" value="&lt;b&gt;xinli-day&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每人每天一个&lt;br&gt;全时记的整理&lt;br&gt;绝对删除期限&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="912" width="198" height="110" as="geometry"/></mxCell><mxCell id="p12-33" value="&lt;b&gt;xinli-project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每个项目一个&lt;br&gt;项目现状&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="278" y="912" width="198" height="110" as="geometry"/></mxCell><mxCell id="p12-34" value="&lt;b&gt;xinli-week&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每人每周一个&lt;br&gt;周回顾 · 画像&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="486" y="912" width="198" height="110" as="geometry"/></mxCell><mxCell id="p12-35" value="&lt;b&gt;xinli-assistant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每个话题线程一个&lt;br&gt;问答 · 重答 · 卡片&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="694" y="912" width="198" height="110" as="geometry"/></mxCell><mxCell id="p12-36" value="&lt;b&gt;xinli-brief&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每人一个&lt;br&gt;心力优先（规划）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="902" y="912" width="198" height="110" as="geometry"/></mxCell><mxCell id="p12-37" value="&lt;span style=&quot;font-size:12px;color:#2e5e2b&quot;&gt;问答连续性靠 Memory 召回与 Persona，不靠一个无限长的 Session；删除一个线程就是删除一个 Session；内部工作 Session 只由编排器写入，BFF 拒绝用户向它提交&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="1030" width="1030" height="76" as="geometry"/></mxCell><mxCell id="p12-38" value="&lt;b&gt;可信页渲染 + 审核&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;attests_speakers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0050&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1215" y="876" width="170" height="108" as="geometry"/></mxCell><mxCell id="p12-39" value="&lt;b&gt;出站流 Outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;与日志原子提交&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0046&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1395" y="876" width="170" height="108" as="geometry"/></mxCell><mxCell id="p12-40" value="&lt;b&gt;单次调用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;实况预览：无 Session&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0047&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1575" y="876" width="170" height="108" as="geometry"/></mxCell><mxCell id="p12-41" value="&lt;b&gt;定时 Schedule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;平台来源&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0045&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1215" y="996" width="170" height="108" as="geometry"/></mxCell><mxCell id="p12-42" value="&lt;b&gt;档位 Tier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;会员等级 → 每日配额&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1395" y="996" width="170" height="108" as="geometry"/></mxCell><mxCell id="p12-43" value="&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;只存关于本人的陈述&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1575" y="996" width="170" height="108" as="geometry"/></mxCell><mxCell id="p12-44" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="124" as="sourcePoint"/><mxPoint x="300" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p12-45" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="308" y="138" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-46" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="278" as="sourcePoint"/><mxPoint x="150" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p12-47" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="158" y="410" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-48" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="386" as="sourcePoint"/><mxPoint x="1115" y="950" as="targetPoint"/><Array as="points"><mxPoint x="1160" y="950"/></Array></mxGeometry></mxCell><mxCell id="p12-49" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1168" y="420" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-50" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1168" y="448" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-51" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1124" y="920" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-52" value="" style="edgeStyle=none;startArrow=block;startFill=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="169" y="912" as="sourcePoint"/><mxPoint x="169" y="786" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p12-53" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="178" y="812" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-54" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="204" y="812" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-55" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1023" y="522" as="sourcePoint"/><mxPoint x="1100" y="386" as="targetPoint"/><Array as="points"><mxPoint x="1100" y="522"/></Array></mxGeometry></mxCell><mxCell id="p12-56" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="498" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-57" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480" y="876" as="sourcePoint"/><mxPoint x="1480" y="386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p12-58" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1488" y="800" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-59" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="1000" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-60" value="一天（圆点编号对应图中位置；跨进程驱动由 make day / day-ark 验收）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1720" height="180" as="geometry"/></mxCell><mxCell id="p12-61" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="56" y="1190" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-62" value="采集把当天的文字批次交给 Persona，按业务日保存原文" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="86" y="1186" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-63" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="56" y="1224" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-64" value="编排器为业务日创建或复用当天的 xinli-day Session（带绝对删除期限）并绑定" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="86" y="1220" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-65" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="56" y="1258" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-66" value="静默满 5 分钟（或傍晚、凌晨）时，经服务令牌提交固定指令&quot;整理今天&quot;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="86" y="1254" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-67" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="56" y="1292" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-68" value="Run 调 captures 读可信页：平台渲染、写日志前审核，按说话人推导来源" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="86" y="1288" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-69" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="916" y="1190" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-70" value="file_changes / file_day 交出变更集；Persona 同一事务推进处理进度、记下领域变化" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="946" y="1186" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-71" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="916" y="1224" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-72" value="编排器据领域变化的事实版本，向各项目的 xinli-project 提交&quot;整理 &amp;lt;日期&amp;gt;&quot;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="946" y="1220" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-73" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="916" y="1258" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-74" value="出站流 → 出站消费 → 推送 / 渠道（业务事实提醒由应用直接建任务，不经模型）" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="946" y="1254" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-75" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="916" y="1292" width="22" height="22" as="geometry"/></mxCell><mxCell id="p12-76" value="到期：内核删除工作 Session；Persona 原文自然到期；交谈、承诺、Memory 保留" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="946" y="1288" width="820" height="30" as="geometry"/></mxCell><mxCell id="p12-77" value="&lt;b&gt;删除一段谈话（擦除，ADR-0050）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;① BFF 把 10:15–10:40 换算成引用范围，调用 Persona 擦除 ② Persona 同一事务：删原文、去掉依据相交的变更集并重新叠加、处理进度回退、停用当天工作 Session、记下删除待办 ③ 编排器以 erasure 删除当天工作 Session（保留 Memory），列出候选 Memory 由用户决定 ④ 需要时重建工作 Session，继承原删除期限&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="860" height="110" as="geometry"/></mxCell><mxCell id="p12-78" value="&lt;b&gt;xinli 的数据控制与边界&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;· 原文只在 Persona；内核只有已读可信页的副本，随工作 Session 删除&lt;br&gt;· 他人的信息只记在 Persona，不写成 Memory 的 relationship（人只记一处）&lt;br&gt;· 旁听原文不给任何三方；听过他人旁听的 Session 不能调用三方&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="920" y="1350" width="840" height="110" as="geometry"/></mxCell><mxCell id="p12-79" value="业务逻辑落在哪里（非测试代码规模，2026-10-31）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="1720" height="140" as="geometry"/></mxCell><mxCell id="p12-80" value="&lt;b&gt;AgentDef&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;4 份 YAML · 129 行&lt;br&gt;指令 · 能力白名单 · 上下文策略&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="56" y="1514" width="300" height="92" as="geometry"/></mxCell><mxCell id="p12-81" value="&lt;b&gt;Persona（MCP 工具 + 查询 API）· 约 1.3 万行 Go&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;变更集检查与回执、承诺与项目、原文与擦除、检索、依据&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="372" y="1514" width="560" height="92" as="geometry"/></mxCell><mxCell id="p12-82" value="&lt;b&gt;xinli 应用层 · 约 1.3 万行 Go&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;BFF、自动调度、编排器、出站消费、推送、账号与权益&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="948" y="1514" width="560" height="92" as="geometry"/></mxCell><mxCell id="p12-83" value="&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;业务的复杂度几乎都在内核之外；内核为 xinli 补的是原语（第 04 页），不是业务逻辑&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1524" y="1514" width="230" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="13 通用性风险"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1140" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13-1" value="&lt;b&gt;通用性风险&lt;/b&gt;　内核原语只有 xinli 一个样本；&quot;第二条业务线也需要&quot;目前是预测，B 端与流程型业务会集中碰到下面的限制" style="text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="36" as="geometry"/></mxCell><mxCell id="p13-2" value="&lt;b&gt;A. 限制在实际场景中的频率&lt;/b&gt;　C 端个人助手基本够用；接入 B 端或流程型业务时，前四条会在第一周出现" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1720" height="30" as="geometry"/></mxCell><mxCell id="p13-3" value="限制" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="300" height="34" as="geometry"/></mxCell><mxCell id="p13-4" value="C 端个人助手" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="96" width="120" height="34" as="geometry"/></mxCell><mxCell id="p13-5" value="B 端 · 流程型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="120" height="34" as="geometry"/></mxCell><mxCell id="p13-6" value="现在的绕法" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="96" width="520" height="34" as="geometry"/></mxCell><mxCell id="p13-7" value="绕法的代价" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="96" width="660" height="34" as="geometry"/></mxCell><mxCell id="p13-8" value="业务知识不能在 Run 开始时注入" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="48" as="geometry"/></mxCell><mxCell id="p13-9" value="&lt;b&gt;中&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-10" value="&lt;b&gt;很高&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-11" value="指令要求模型先调工具拉取（ADR-0043 有意不自动注入）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="130" width="520" height="48" as="geometry"/></mxCell><mxCell id="p13-12" value="多一轮调用，模型可能漏调；若把检索结果塞进输入，会被算作用户原话 —— 外部内容被洗成可信内容" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="130" width="660" height="48" as="geometry"/></mxCell><mxCell id="p13-13" value="Run 内的流程控制" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="178" width="300" height="48" as="geometry"/></mxCell><mxCell id="p13-14" value="&lt;b&gt;中&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="178" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-15" value="&lt;b&gt;很高&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="178" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-16" value="外部 Loop 已定未实现（ADR-0041）；目前只能自写编排器逐步开 Run，或把确定性步骤塞进一个 MCP 工具" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="178" width="520" height="48" as="geometry"/></mxCell><mxCell id="p13-17" value="每条业务线重造带持久化的流程引擎；外部 Loop 落地后缺口收窄，但每步一次往返、第一版不流式、完整上下文离开平台" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="178" width="660" height="48" as="geometry"/></mxCell><mxCell id="p13-18" value="一个 Session 只属于一个 EndUser" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="300" height="48" as="geometry"/></mxCell><mxCell id="p13-19" value="&lt;b&gt;低&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="226" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-20" value="&lt;b&gt;高&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="226" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-21" value="每人一个 Session，业务侧转发群消息" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="226" width="520" height="48" as="geometry"/></mxCell><mxCell id="p13-22" value="群里他人的话来源难以推导；群的上下文散在多个 Session 中" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="226" width="660" height="48" as="geometry"/></mxCell><mxCell id="p13-23" value="没有人工坐席接管" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="300" height="48" as="geometry"/></mxCell><mxCell id="p13-24" value="&lt;b&gt;低&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="274" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-25" value="&lt;b&gt;高&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="274" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-26" value="业务侧中断 Run，坐席在 Agent 之外回复" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="274" width="520" height="48" as="geometry"/></mxCell><mxCell id="p13-27" value="坐席的回复不在日志里，Agent 恢复后看不到；审计链断开" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="274" width="660" height="48" as="geometry"/></mxCell><mxCell id="p13-28" value="可信片段只覆盖&quot;说话人&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="300" height="48" as="geometry"/></mxCell><mxCell id="p13-29" value="&lt;b&gt;—&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="322" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-30" value="&lt;b&gt;中&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="322" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-31" value="把邮件发件人、文档作者套成&quot;说话人&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="322" width="520" height="48" as="geometry"/></mxCell><mxCell id="p13-32" value="来源字段语义错位" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="322" width="660" height="48" as="geometry"/></mxCell><mxCell id="p13-33" value="卡片是一组固定积木" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="300" height="48" as="geometry"/></mxCell><mxCell id="p13-34" value="&lt;b&gt;低&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="370" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-35" value="&lt;b&gt;中&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="370" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-36" value="用标题、键值、列表、字段、按钮拼复杂界面" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="370" width="520" height="48" as="geometry"/></mxCell><mxCell id="p13-37" value="图表、复杂表单只能退化" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="370" width="660" height="48" as="geometry"/></mxCell><mxCell id="p13-38" value="分类写死（Memory 类别、来源种类、能力种类）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="300" height="48" as="geometry"/></mxCell><mxCell id="p13-39" value="&lt;b&gt;低&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="418" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-40" value="&lt;b&gt;低&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="460" y="418" width="120" height="48" as="geometry"/></mxCell><mxCell id="p13-41" value="—" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="418" width="520" height="48" as="geometry"/></mxCell><mxCell id="p13-42" value="很少真的需要改；来源种类本应固定，它就是信任模型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1100" y="418" width="660" height="48" as="geometry"/></mxCell><mxCell id="p13-43" value="&lt;b&gt;B. 为 xinli 补的原语：换一条形态不同的业务线推演&lt;/b&gt;　（B 端客服、邮件助手、群聊办公助手）" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1720" height="30" as="geometry"/></mxCell><mxCell id="p13-44" value="原语" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="330" height="34" as="geometry"/></mxCell><mxCell id="p13-45" value="判定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="516" width="120" height="34" as="geometry"/></mxCell><mxCell id="p13-46" value="换成 B 端客服 / 邮件 / 群聊时" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="516" width="600" height="34" as="geometry"/></mxCell><mxCell id="p13-47" value="通用形态（第 14 页）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="516" width="670" height="34" as="geometry"/></mxCell><mxCell id="p13-48" value="可信结构化片段 attests_speakers&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0050&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-49" value="&lt;b&gt;xinli 形状&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="550" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-50" value="邮件的发件人、文档的作者、会议的参会人，同样需要&quot;每一段的来源由结构化字段给出&quot;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="550" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-51" value="&lt;b&gt;结构化来源契约&lt;/b&gt;：业务登记内容结构，平台渲染并按字段标注来源" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="550" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-52" value="说话人引用 speaker_ref" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="596" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-53" value="&lt;b&gt;xinli 形状&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="596" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-54" value="同上，只覆盖&quot;说话人&quot;一种" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="596" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-55" value="并入结构化来源契约" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="596" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-56" value="擦除 = 删除工作 Session · 绝对删除期限&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0050&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="642" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-57" value="&lt;b&gt;偏窄&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="642" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-58" value="删除一封邮件、一条群消息，不应删掉整个长期 Session" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="642" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-59" value="通用模式：&lt;b&gt;按删除粒度切分 Session&lt;/b&gt;（xinli 每天一个工作 Session 即是）；更细的粒度要重新评估 ADR-0015 否决过的加密销毁" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="642" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-60" value="重答 Redo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-61" value="&lt;b&gt;偏窄&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="688" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-62" value="编辑历史消息、从某处分叉、回滚到某一步" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="688" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-63" value="&lt;b&gt;Session 分叉&lt;/b&gt;（新提议）：从某个 seq 派生分支，Transcript 只看当前分支" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="688" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-64" value="出站流 Outbox&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0046&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="734" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-65" value="&lt;b&gt;通用&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="734" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-66" value="工单状态同步、群消息转发；按需增加信封种类" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="734" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-67" value="保持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="734" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-68" value="定时 Schedule&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0045&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-69" value="&lt;b&gt;通用&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="780" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-70" value="提醒、SLA 超时、周期任务" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="780" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-71" value="保持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="780" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-72" value="单次调用 Oneshot&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0047&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="826" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-73" value="&lt;b&gt;通用&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="826" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-74" value="分类、抽取、预览" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="826" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-75" value="保持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="826" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-76" value="写日志前审核可信页" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-77" value="&lt;b&gt;通用&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="872" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-78" value="任何平台渲染的结构化内容都需要" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="872" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-79" value="保持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="872" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-80" value="档位 Tier · EndUser 删除屏障" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-81" value="&lt;b&gt;通用&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="918" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-82" value="会员分档、企业套餐；注销" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="918" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-83" value="保持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="918" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-84" value="A2A&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0048&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="964" width="330" height="46" as="geometry"/></mxCell><mxCell id="p13-85" value="&lt;b&gt;通用&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="370" y="964" width="120" height="46" as="geometry"/></mxCell><mxCell id="p13-86" value="对接企业内外的其他 Agent" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="964" width="600" height="46" as="geometry"/></mxCell><mxCell id="p13-87" value="保持（规划中）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1090" y="964" width="670" height="46" as="geometry"/></mxCell><mxCell id="p13-88" value="&lt;b&gt;推演建议&lt;/b&gt;&lt;br&gt;① 选一条与 xinli 形态差异最大的业务线（B 端客服或群聊办公助手），按第 04 页&quot;新功能五步&quot;在纸面上走一遍，逐项记录需要的内核改动，用它检验&quot;改内核判据&quot;&lt;br&gt;② 带 xinli 形状的两项（attests_speakers、speaker_ref）应在第二条业务线接入&lt;b&gt;之前&lt;/b&gt;改成通用形态，否则会被已有依赖锁死&lt;br&gt;③ 频率&quot;很高&quot;的两项：Run 内流程已有 ADR-0041（外部 Loop），只差落地；上下文注入与 ADR-0043&quot;不自动注入&quot;的决定相反，要写新 ADR 改判" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1720" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="14 目标架构与演进路径"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1140" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p14-1" value="&lt;b&gt;目标架构与演进路径&lt;/b&gt;　不考虑现有实现：保留内核的保证，把扩展边界从&quot;一个 Agent + 一份配置&quot;推到几份通用契约" style="text;html=1;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="36" as="geometry"/></mxCell><mxCell id="p14-2" value="&lt;b&gt;原则：灵活性在外，保证在内&lt;/b&gt; —— 业务经契约扩展，扩展只能收紧、不能绕过平台检查点　｜　实线 = 保留　虚线 = 新增或重构，并标出与已有决定的关系：&lt;b&gt;已定未实现&lt;/b&gt; · &lt;b&gt;改判&lt;/b&gt; · &lt;b&gt;新提议&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=14;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1720" height="40" as="geometry"/></mxCell><mxCell id="p14-3" value="业务层（内核之外）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="220" y="116" width="960" height="104" as="geometry"/></mxCell><mxCell id="p14-4" value="&lt;b&gt;业务知识服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;如 Persona：领域规则与存储&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="234" y="144" width="302" height="62" as="geometry"/></mxCell><mxCell id="p14-5" value="&lt;b&gt;业务编排&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;只剩跨 Session 的产品逻辑，变薄&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="548" y="144" width="302" height="62" as="geometry"/></mxCell><mxCell id="p14-6" value="&lt;b&gt;BFF · 渠道 · 推送&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;账号、权益、运营&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="862" y="144" width="302" height="62" as="geometry"/></mxCell><mxCell id="p14-7" value="公开契约与接入（Gateway · HTTP API · Connection · SDK · 服务令牌）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="220" y="236" width="960" height="186" as="geometry"/></mxCell><mxCell id="p14-8" value="&lt;b&gt;HTTP API · Connection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;一条连接兼任 Node 与会话客户端&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="234" y="264" width="226" height="58" as="geometry"/></mxCell><mxCell id="p14-9" value="&lt;b&gt;MCP 登记&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;只读声明 · 可信登记&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="468" y="264" width="226" height="58" as="geometry"/></mxCell><mxCell id="p14-10" value="&lt;b&gt;令牌&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;业务线签发，yanshi 只验证&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="702" y="264" width="226" height="58" as="geometry"/></mxCell><mxCell id="p14-11" value="&lt;b&gt;AgentDef&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;声明：指令、白名单、策略&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="936" y="264" width="226" height="58" as="geometry"/></mxCell><mxCell id="p14-12" value="&lt;b&gt;外部 Loop 登记&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每步一问 · 已定未实现&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0041&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="234" y="332" width="226" height="72" as="geometry"/></mxCell><mxCell id="p14-13" value="&lt;b&gt;上下文提供者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;Run 开始时调用 · 改判 ADR-0043&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="468" y="332" width="226" height="72" as="geometry"/></mxCell><mxCell id="p14-14" value="&lt;b&gt;策略叠加&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;只能更严 · 新提议&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="702" y="332" width="226" height="72" as="geometry"/></mxCell><mxCell id="p14-15" value="&lt;b&gt;结构化来源契约&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按字段标来源 · 新提议&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="936" y="332" width="226" height="72" as="geometry"/></mxCell><mxCell id="p14-16" value="执行内核（持久执行引擎：Event 日志是唯一事实源）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f7ef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="220" y="438" width="960" height="312" as="geometry"/></mxCell><mxCell id="p14-17" value="&lt;b&gt;Session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;参与者集合：EndUser · 群成员 · 坐席（新提议）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="234" y="468" width="226" height="70" as="geometry"/></mxCell><mxCell id="p14-18" value="&lt;b&gt;Loop 接缝&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;内置循环 · 外部 Loop；只做决定，动作都由平台执行&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="468" y="468" width="226" height="70" as="geometry"/></mxCell><mxCell id="p14-19" value="&lt;b&gt;Run · Attempt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;挂起 · 恢复 · fencing&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="702" y="468" width="226" height="70" as="geometry"/></mxCell><mxCell id="p14-20" value="&lt;b&gt;Event 日志&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;decide–commit · 日志与队列同事务&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="936" y="468" width="226" height="70" as="geometry"/></mxCell><mxCell id="p14-21" value="&lt;b&gt;定时 Schedule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;平台来源&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="234" y="550" width="226" height="56" as="geometry"/></mxCell><mxCell id="p14-22" value="&lt;b&gt;出站流 Outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;与日志原子提交&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="468" y="550" width="226" height="56" as="geometry"/></mxCell><mxCell id="p14-23" value="&lt;b&gt;Session 分叉&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;← Redo（新提议）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="702" y="550" width="226" height="56" as="geometry"/></mxCell><mxCell id="p14-24" value="&lt;b&gt;单次调用 Oneshot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;同一策略管线&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="936" y="550" width="226" height="56" as="geometry"/></mxCell><mxCell id="p14-25" value="&lt;span style=&quot;font-size:11px;color:#2e5e2b&quot;&gt;&lt;b&gt;上下文平面&lt;/b&gt;（组装顺序固定，提供者结果记为 Event、放在 Run 的位置上）&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="234" y="614" width="600" height="22" as="geometry"/></mxCell><mxCell id="p14-26" value="&lt;b&gt;指令&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;稳定前缀&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="234" y="640" width="168" height="56" as="geometry"/></mxCell><mxCell id="p14-27" value="&lt;b&gt;Memory 召回&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;内置提供者&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="427" y="640" width="168" height="56" as="geometry"/></mxCell><mxCell id="p14-28" value="&lt;b&gt;业务上下文提供者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;超时 · 失败走默认&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="620" y="640" width="168" height="56" as="geometry"/></mxCell><mxCell id="p14-29" value="&lt;b&gt;Transcript&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;只在尾部追加&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="813" y="640" width="168" height="56" as="geometry"/></mxCell><mxCell id="p14-30" value="&lt;b&gt;压缩&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1006" y="640" width="168" height="56" as="geometry"/></mxCell><mxCell id="p14-31" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="p14-26" target="p14-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p14-32" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeCol