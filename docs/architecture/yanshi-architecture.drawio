whiteSpace=wrap;html=1;fillColor=#f0f7ef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="64" width="420" height="560" as="geometry"/></mxCell><mxCell id="p05-11" value="① 同步日志 → Reduce 得到投影 State" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="378" y="100" width="360" height="66" as="geometry"/></mxCell><mxCell id="p05-12" value="② decide(State) → 要追加的事件 + Decision.Wake" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="378" y="180" width="360" height="66" as="geometry"/></mxCell><mxCell id="p05-13" value="③ 校验：Apply 再校验平台专属字段" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="378" y="260" width="360" height="66" as="geometry"/></mxCell><mxCell id="p05-14" value="④ Append(expectedSeq)：乐观并发追加" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="378" y="340" width="360" height="66" as="geometry"/></mxCell><mxCell id="p05-15" value="⑤ 冲突 → 回到 ①，看新投影&lt;b&gt;重新决定&lt;/b&gt;&lt;br&gt;（不重放旧事件，不另写重试循环）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="378" y="420" width="360" height="66" as="geometry"/></mxCell><mxCell id="p05-16" value="⑥ Wake → CommitAndWake：&lt;br&gt;日志与队列在&lt;b&gt;同一事务&lt;/b&gt;提交，没有丢唤醒的窗口" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="378" y="500" width="360" height="66" as="geometry"/></mxCell><mxCell id="p05-17" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="738" y="453" as="sourcePoint"/><mxPoint x="760" y="453" as="targetPoint"/><Array as="points"><mxPoint x="760" y="453"/><mxPoint x="760" y="133"/></Array></mxGeometry></mxCell><mxCell id="p05-18" value="" style="edgeStyle=none;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="133" as="sourcePoint"/><mxPoint x="738" y="133" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-19" value="&lt;span style=&quot;font-size:11px;color:#b85450&quot;&gt;冲突&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="762" y="280" width="36" height="24" as="geometry"/></mxCell><mxCell id="p05-20" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="344" as="sourcePoint"/><mxPoint x="360" y="344" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-21" value="&lt;b&gt;Event 日志&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每 Session 一条 · 只追加&lt;br&gt;seq 由日志分配、连续递增&lt;br&gt;唯一事实源&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#eeeeee;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry x="830" y="80" width="270" height="170" as="geometry"/></mxCell><mxCell id="p05-22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="738" y="373" as="sourcePoint"/><mxPoint x="830" y="165" as="targetPoint"/><Array as="points"><mxPoint x="800" y="373"/><mxPoint x="800" y="165"/></Array></mxGeometry></mxCell><mxCell id="p05-23" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;Append&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="766" y="376" width="70" height="24" as="geometry"/></mxCell><mxCell id="p05-24" value="&lt;b&gt;投影 State&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;纯函数 Reduce(events) → State&lt;br&gt;快照只是缓存：改 Apply / State 递增 ProjectionVersion&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="830" y="300" width="270" height="90" as="geometry"/></mxCell><mxCell id="p05-25" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="965" y="250" as="sourcePoint"/><mxPoint x="965" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-26" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;Reduce&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="972" y="258" width="100" height="30" as="geometry"/></mxCell><mxCell id="p05-27" value="&lt;b&gt;工作队列：只负责活性&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按 Session 发放带 TTL 的租约&lt;br&gt;交互级 / 长任务分类认领（ADR-0029）&lt;br&gt;Park until：挂起时归还&lt;br&gt;远期停放由 Janitor 提升&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="830" y="440" width="270" height="170" as="geometry"/></mxCell><mxCell id="p05-28" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="738" y="553" as="sourcePoint"/><mxPoint x="830" y="553" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-29" value="Worker 池（无状态）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f7ef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1150" y="64" width="300" height="560" as="geometry"/></mxCell><mxCell id="p05-30" value="认领租约（交互池先取交互级）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1168" y="100" width="264" height="66" as="geometry"/></mxCell><mxCell id="p05-31" value="追加 AttemptStarted(n + 1)&lt;br&gt;写入 live_endpoint" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1168" y="192" width="264" height="66" as="geometry"/></mxCell><mxCell id="p05-32" value="一步：一次模型调用&lt;br&gt;或处理一个能力调用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1168" y="284" width="264" height="66" as="geometry"/></mxCell><mxCell id="p05-33" value="经 Store.Update 追加&lt;br&gt;（每批携带自己的 Attempt 号）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1168" y="376" width="264" height="66" as="geometry"/></mxCell><mxCell id="p05-34" value="挂起 → Park；完成 → 释放&lt;br&gt;长任务 → handoff 移交" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1168" y="468" width="264" height="66" as="geometry"/></mxCell><mxCell id="p05-35" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="166" as="sourcePoint"/><mxPoint x="1300" y="192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-36" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="258" as="sourcePoint"/><mxPoint x="1300" y="284" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-37" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="350" as="sourcePoint"/><mxPoint x="1300" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-38" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="442" as="sourcePoint"/><mxPoint x="1300" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-39" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="525" as="sourcePoint"/><mxPoint x="1150" y="133" as="targetPoint"/><Array as="points"><mxPoint x="1125" y="525"/><mxPoint x="1125" y="133"/></Array></mxGeometry></mxCell><mxCell id="p05-40" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;认领&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="1104" y="534" width="46" height="50" as="geometry"/></mxCell><mxCell id="p05-41" value="&lt;b&gt;实时增量不进日志&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;token 增量只经 LiveBus 扇出，带 run_id 与 attempt&lt;br&gt;&lt;br&gt;跨进程：订阅方按 AttemptStarted.live_endpoint 向执行进程拉取&lt;br&gt;&lt;br&gt;丢失的增量由随后提交的完整事件覆盖&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0013&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=middle;spacing=5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="64" width="190" height="300" as="geometry"/></mxCell><mxCell id="p05-42" value="" style="edgeStyle=none;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1432" y="266" as="sourcePoint"/><mxPoint x="1480" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-43" value="&lt;b&gt;正确性来自日志而非锁&lt;/b&gt;&lt;br&gt;即使租约出错、两个 Worker 同时执行，日志的乐观并发 + Attempt fencing 也只让当前 Attempt 的事件提交成功" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1480" y="384" width="190" height="240" as="geometry"/></mxCell><mxCell id="p05-44" value="日志的读者（都只读日志或投影）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1630" height="130" as="geometry"/></mxCell><mxCell id="p05-45" value="&lt;b&gt;事件流 feed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;从 seq 起补发 + 实时推送&lt;br&gt;断线带上最后的 seq 续传&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="682" width="260" height="84" as="geometry"/></mxCell><mxCell id="p05-46" value="&lt;b&gt;出站流信封&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;与事件原子提交&lt;br&gt;业务线按游标拉取&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="324" y="682" width="260" height="84" as="geometry"/></mxCell><mxCell id="p05-47" value="&lt;b&gt;Transcript&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;模型上下文 = 最新摘要&lt;br&gt;+ 其后历史（压缩是一条 Event）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="593" y="682" width="260" height="84" as="geometry"/></mxCell><mxCell id="p05-48" value="&lt;b&gt;来源推导&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;写入闸门、注入判断&lt;br&gt;只看 Provenance&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="862" y="682" width="260" height="84" as="geometry"/></mxCell><mxCell id="p05-49" value="&lt;b&gt;模拟测试&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每步后检查不变量&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1131" y="682" width="260" height="84" as="geometry"/></mxCell><mxCell id="p05-50" value="&lt;b&gt;删除&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;整个 Session 物理删除&lt;br&gt;只留删除记录&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1400" y="682" width="260" height="84" as="geometry"/></mxCell><mxCell id="p05-51" value="能力调用的三段式与恢复规则（有副作用的调用绝不重复执行）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="900" height="250" as="geometry"/></mxCell><mxCell id="p05-52" value="&lt;b&gt;请求&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;AssistantMessage.tool_calls&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="270" height="76" as="geometry"/></mxCell><mxCell id="p05-53" value="&lt;b&gt;ToolCallStarted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;执行&lt;b&gt;之前&lt;/b&gt;落盘&lt;br&gt;记录 read_only 证据&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="360" y="840" width="270" height="76" as="geometry"/></mxCell><mxCell id="p05-54" value="&lt;b&gt;ToolResult&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;结果写回，唤醒 Session&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="660" y="840" width="270" height="76" as="geometry"/></mxCell><mxCell id="p05-55" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="878" as="sourcePoint"/><mxPoint x="360" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-56" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="878" as="sourcePoint"/><mxPoint x="660" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p05-57" value="有请求、无 Started → 从未执行，可安全执行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="60" y="936" width="420" height="92" as="geometry"/></mxCell><mxCell id="p05-58" value="有 Started、无结果 → 幂等则重新执行；&lt;br&gt;否则写入 &quot;outcome unknown&quot;，交给模型决定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="936" width="420" height="92" as="geometry"/></mxCell><mxCell id="p05-59" value="&lt;b&gt;确定性单步，模拟测试是执行语义的裁判&lt;/b&gt;&lt;br&gt;· Worker.Step 同步完成一件事、内部不起 goroutine；时间取 clock.Clock，ID 取 ids.Generator&lt;br&gt;· internal/sim 用固定种子交错多个 Worker 与客户端，在任意两步之间注入：Worker 崩溃、租约过期、模型错误、&quot;已生效但报告失败&quot;的写入、丢失唤醒&lt;br&gt;· 不变量：终态后无事件、Attempt 单调、每个调用至多一个结果、非幂等调用不重复执行、至多一个活跃 Run；停止注入后所有 Run 在有限步内终止&lt;br&gt;· 失败打印种子，同一种子完全复现" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="970" y="800" width="700" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p06" name="06 Run 生命周期"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p06-1" value="&lt;b&gt;Run 生命周期&lt;/b&gt;　小时级任务靠&quot;挂起不占 Worker、任意 Worker 恢复&quot;实现；接管只看日志" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1620" height="36" as="geometry"/></mxCell><mxCell id="p06-2" value="Run 状态机（一个 Session 同一时刻至多一个非终态 Run）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f7ef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="760" height="540" as="geometry"/></mxCell><mxCell id="p06-3" value="" style="ellipse;fillColor=#333333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="66" y="160" width="22" height="22" as="geometry"/></mxCell><mxCell id="p06-4" value="queued" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="140" width="150" height="62" as="geometry"/></mxCell><mxCell id="p06-5" value="running" style="rounde