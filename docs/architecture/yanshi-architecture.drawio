"/></mxCell><mxCell id="p04-4" value="&lt;b&gt;采集与识别&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;有序采集会话 · 同 ID 重交&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="165" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-5" value="&lt;b&gt;账号 · 设备 · 声纹 · 权益&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;权益变化同步内核档位&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="320" y="165" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-6" value="&lt;b&gt;BFF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;产品唯一入口 · 不下发内核令牌&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="585" y="165" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-7" value="&lt;b&gt;编排器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;领域变化 → 持久任务 → 提交 Run&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="850" y="165" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-8" value="&lt;b&gt;渠道适配&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;微信 / 飞书（规划）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="55" y="237" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-9" value="&lt;b&gt;推送&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;唯一实际发送方&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="320" y="237" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-10" value="&lt;b&gt;出站消费与恢复&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;每分片游标 · 至少一次&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="585" y="237" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-11" value="&lt;b&gt;运营&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;版本分发 · 指标只含 ID&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="850" y="237" width="255" height="62" as="geometry"/></mxCell><mxCell id="p04-12" value="&lt;span style=&quot;font-size:12px;color:#5b3f6b&quot;&gt;应用库：账号、设备、权益、渠道映射、收藏、编排任务与收件箱&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="55" y="308" width="1050" height="34" as="geometry"/></mxCell><mxCell id="p04-13" value="Persona 层（persona/）—— 关于一个人的世界的结构化知识" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="760" height="240" as="geometry"/></mxCell><mxCell id="p04-14" value="&lt;b&gt;实体&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;人 · 组织 · 概念 · 事件&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="435" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-15" value="&lt;b&gt;交谈 · 时段&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;由旁听整理&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="241" y="435" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-16" value="&lt;b&gt;承诺账本&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;对方引用实体&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="427" y="435" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-17" value="&lt;b&gt;项目 · 日 / 周总览&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;直接事实&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="613" y="435" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-18" value="&lt;b&gt;原文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按业务日 · 7 天期限&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="507" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-19" value="&lt;b&gt;有效变更集&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;+ 依据索引（级联删除）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="241" y="507" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-20" value="&lt;b&gt;关注项 · 目标 · 词库&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="427" y="507" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-21" value="&lt;b&gt;接口&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;MCP 工具 · 查询 API · 对外 MCP&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="613" y="507" width="178" height="62" as="geometry"/></mxCell><mxCell id="p04-22" value="&lt;span style=&quot;font-size:12px;color:#5b3f6b&quot;&gt;Persona 库：独立 PostgreSQL，按 (业务线, EndUser) 分片；有效变更集与直接事实是事实源；用户改动优先&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="55" y="580" width="740" height="50" as="geometry"/></mxCell><mxCell id="p04-23" value="yanshi 内核 —— Agent 怎样运行（不认识任何业务实体）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f0f7ef;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1080" height="340" as="geometry"/></mxCell><mxCell id="p04-24" value="&lt;b&gt;Session · Run · Event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;执行语义&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="55" y="725" width="168" height="62" as="geometry"/></mxCell><mxCell id="p04-25" value="&lt;b&gt;能力路由&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;设备 · 沙箱 · MCP · 委托 · A2A&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="231" y="725" width="168" height="62" as="geometry"/></mxCell><mxCell id="p04-26" value="&lt;b&gt;来源 · 写入闸门&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;内容安全 · 审批&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="407" y="725" width="168" height="62" as="geometry"/></mxCell><mxCell id="p04-27" value="&lt;b&gt;Memory · Grant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;关于本人的陈述&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="583" y="725" width="168" height="62" as="geometry"/></mxCell><mxCell id="p04-28" value="&lt;b&gt;配额 · 计量&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按业务线 / EndUser&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="759" y="725" width="168" height="62" as="geometry"/></mxCell><mxCell id="p04-29" value="&lt;b&gt;删除与保留&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;按 Session / EndUser&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="935" y="725" width="168" height="62" as="geometry"/></mxCell><mxCell id="p04-30" value="为业务线补的内核原语（每项都满足&quot;改内核判据&quot;，并写了 ADR）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcf0f0;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="55" y="802" width="1050" height="180" as="geometry"/></mxCell><mxCell id="p04-31" value="&lt;b&gt;可信结构化片段&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;attests_speakers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0050&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="68" y="835" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-32" value="&lt;b&gt;写日志前审核可信页&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;不以业务线自报代替&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="276" y="835" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-33" value="&lt;b&gt;擦除 = 删工作 Session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;绝对删除期限&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0050&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="484" y="835" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-34" value="&lt;b&gt;EndUser 删除屏障&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;注销期间写入不复活&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="692" y="835" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-35" value="&lt;b&gt;定时 Schedule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;平台来源，不算用户原话&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0045&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="900" y="835" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-36" value="&lt;b&gt;出站流 Outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;与日志原子提交&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0046&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="68" y="907" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-37" value="&lt;b&gt;单次调用 Oneshot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;不绕过计量与审核&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0047&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="276" y="907" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-38" value="&lt;b&gt;档位 Tier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;会员分档 → 每日配额&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="484" y="907" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-39" value="&lt;b&gt;重答 Redo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;同一输入重新回答&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="692" y="907" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-40" value="&lt;b&gt;A2A&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;三方 Agent（规划）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0048&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="900" y="907" width="200" height="64" as="geometry"/></mxCell><mxCell id="p04-41" value="&lt;span style=&quot;font-size:12px;color:#2e5e2b&quot;&gt;内核库：事件日志（含已读可信页副本）、Memory、用量；按 Session / EndUser 分片&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="55" y="990" width="1050" height="34" as="geometry"/></mxCell><mxCell id="p04-42" value="" style="edgeStyle=none;startArrow=block;startFill=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="106" as="sourcePoint"/><mxPoint x="580" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p04-43" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;应用登录态（经 BFF）：输入 · 审批 · 回答 · 事件流；采集上传&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="590" y="106" width="520" height="24" as="geometry"/></mxCell><mxCell id="p04-44" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="350" as="sourcePoint"/><mxPoint x="300" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p04-45" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;查询与用户改动 · 原文提交 · 擦除&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="310" y="356" width="400" height="40" as="geometry"/></mxCell><mxCell id="p04-46" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="350" as="sourcePoint"/><mxPoint x="960" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p04-47" value="&lt;span style=&quot;font-size:12px;color:#222222&quot;&gt;服务令牌：&lt;br&gt;输入 · 定时&lt;br&gt;Session · 档位&lt;br&gt;出站流（拉取）&lt;br&gt;单次调用&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="972" y="420" width="150" height="150" as="geometry"/></mxCell><mxCell id="p04-48" value="" style="edgeStyle=none;dashed=1;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="690" as="sourcePoint"/><mxPoint x="500" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p04-49" value="&lt;span style=&quot;font-size:11px;color:#222222&quot;&gt;运行时：Agent 经 MCP 调用 Persona 工具（可信登记、身份 _meta）&lt;br&gt;内核只把它当作一个能力提供者&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="512" y="646" width="440" height="40" as="geometry"/></mxCell><mxCell id="p04-50" value="&lt;b&gt;依赖方向只有一个&lt;/b&gt;&lt;br&gt;应用层 → Persona → 内核公开契约（proto/ · gen/ · sdk/ · HTTP API · MCP）&lt;br&gt;persona/、apps/xinli 是独立 Go module，不能 import internal/；内核不 import 业务；make check 另做依赖检查" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="64" width="400" height="150" as="geometry"/></mxCell><mxCell id="p04-51" value="&lt;b&gt;改内核的判据&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#333333&quot;&gt;第二条业务线也需要&lt;b&gt;且&lt;/b&gt;业务侧做不到或做了不安全 → 写 ADR；否则只改 Persona 与应用层&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1160" y="234" width="400" height="120" as="geometry"/></mxCell><mxCell id="p04-52" value="&lt;b&gt;新功能五步（默认不改内核）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#333333&quot;&gt;① Persona：新实体类型或变更集操作，及其检查与回执&lt;br&gt;② 工具：Persona 的 MCP 工具，声明是否只读&lt;br&gt;③ AgentDef：新增或修改，写明能力白名单&lt;br&gt;④ 编排：领域变化、应用调度、定时或出站流&lt;br&gt;⑤ 评测：用例 + Persona 夹具的一致性测试&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1160" y="374" width="400" height="210" as="geometry"/></mxCell><mxCell id="p04-53" value="&lt;b&gt;每一步都回答四问&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#333333&quot;&gt;&lt;b&gt;来源&lt;/b&gt;（本人 / 他人 / 外部 / 平台）· &lt;b&gt;删除&lt;/b&gt;（随 Session、EndUser 或擦除）· &lt;b&gt;授权&lt;/b&gt;（三方能否读到）· &lt;b&gt;幂等&lt;/b&gt;（重试与重交）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1160" y="604" width="400" height="110" as="geometry"/></mxCell><mxCell id="p04-54" value="&lt;b&gt;故障域按层分开&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#333333&quot;&gt;三套 PostgreSQL：内核 · Persona · 应用库&lt;br&gt;应用层任何组件故障都不影响内核写日志；Persona 不可用时未接受的不推进处理进度&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1160" y="734" width="400" height="130" as="geometry"/></mxCell><mxCell id="p04-55" value="&lt;b&gt;演进：一个前台、几个专员&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#333333&quot;&gt;前台（问答线程）直接用 Persona 工具；重活经委托交给专员，子 Run 能力不超出前台白名单；加工具、加专员、接三方 Agent，内核不变&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="1160" y="884" width="400" height="140" as="geometry"/></mxCell><mxCell id="p04-56" value="&lt;b&gt;业务扩展面&lt;/b&gt;　AgentDef 只是粘合层：业务逻辑写在 MCP 工具与业务线服务端里；内核不开放内部代码钩子 —— &lt;b&gt;灵活性在外，保证在内&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="1062" width="1520" height="34" as="geometry"/></mxCell><mxCell id="p04-57" value="接入点" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="230" height="34" as="geometry"/></mxCell><mxCell id="p04-58" value="形态" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="270" y="1104" width="90" height="34" as="geometry"/></mxCell><mxCell id="p04-59" value="业务写什么" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="360" y="1104" width="330" height="34" as="geometry"/></mxCell><mxCell id="p04-60" value="平台守住什么" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="690" y="1104" width="420" height="34" as="geometry"/></mxCell><mxCell id="p04-61" value="xinli 中的用法" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="1110" y="1104" width="280" height="34" as="geometry"/></mxCell><mxCell id="p04-62" value="变更方式" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=5;fontColor=#ffffff;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="1390" y="1104" width="170" height="34" as="geometry"/></mxCell><mxCell id="p04-63" value="&lt;b&gt;AgentDef&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="1138" width="230" height="58" as="geometry"/></mxCell><mxCell id="p04-64" value="声明" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="270" y="1138" width="90" height="58" as="geometry"/></mxCell><mxCell id="p04-65" value="指令、模型、能力白名单、max_turns、上下文策略（scope · 窗口 · 压缩）、Memory 与委托配置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="360" y="1138" width="330" height="58" as="geometry"/></mxCell><mxCell id="p04-66" value="版本化、灰度与评测准入&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;ADR-0020&lt;/span&gt;；白名单只收窄" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="690" y="1138" width="420" height="58" as="geometry"/></mxCell><mxCell id="p04-67" value="4 份 YAML，共 129 行：把下面各层粘起来" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1110" y="1138" width="280" height="58" as="geometry"/></mxCell><mxCell id="p04-68" value="发布配置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1390" y="1138" width="170" height="58" as="geometry"/></mxCell><mxCell id="p04-69" value="&lt;b&gt;MCP 工具&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="1196" width="230" height="58" as="geometry"/></mxCell><mxCell id="p04-70" value="代码" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="270" y="1196" width="90" height="58" as="geometry"/></mxCell><mxCell id="p04-71" value="任意业务逻辑：领域规则、存储、检索、给模型看的回执文字；声明是否只读" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spa