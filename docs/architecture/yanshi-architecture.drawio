" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="52" y="266" width="142" height="44" as="geometry"/></mxCell><mxCell id="p14-50" value="&lt;b&gt;模型或 Loop 输出后&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="52" y="320" width="142" height="44" as="geometry"/></mxCell><mxCell id="p14-51" value="&lt;b&gt;能力调用前&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="52" y="374" width="142" height="44" as="geometry"/></mxCell><mxCell id="p14-52" value="&lt;b&gt;Memory 写入前&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="52" y="428" width="142" height="44" as="geometry"/></mxCell><mxCell id="p14-53" value="&lt;b&gt;写日志前&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="52" y="482" width="142" height="44" as="geometry"/></mxCell><mxCell id="p14-54" value="&lt;span style=&quot;font-size:11px;color:#7a2e2b&quot;&gt;位置固定、平台独占，不区分循环是内置还是外部：来源推导 · 内容安全 · 审批 · 写入闸门 · 配额&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="52" y="540" width="142" height="70" as="geometry"/></mxCell><mxCell id="p14-55" value="&lt;b&gt;业务叠加&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#333333&quot;&gt;登记规则或判断模型&lt;br&gt;只能更严&lt;br&gt;失败即拒绝&lt;br&gt;（新提议）&lt;/span&gt;" style="rounde