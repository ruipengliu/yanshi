e_rev），display = base + 已接受的模型编辑（display_rev）。G6 只读 base；模型纠错只改 display，不触发 G6 重算。" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1560" height="22" as="geometry"/></mxCell><mxCell id="p06-n-up" value="上游 G2–G5 证据（04 / 05）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="125" width="240" height="56" as="geometry"/></mxCell><UserObject label="&lt;b&gt;PersistResult 落盘&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;片段 · 句锚 · 会议实例 · 当地日期&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-persist"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="220" width="240" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;acoustic_tier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;落盘时派生：非语音 / 无语音跨度 / 分歧 / 回放中最严；不含播放融合&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-atier"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="330" width="240" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;base 视图&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;asr_text + 用户编辑 · base_rev&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-base"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="450" width="240" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;display 视图&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;base + 已接受模型编辑 · display_rev&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-disp"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="560" width="240" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;覆盖账&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;证明右侧到齐或登记缺口；唤醒重算&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-cov"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="760" width="240" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;ContextSnapshot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;前后各 60 s · ≤2,000 token；邻段按 acoustic_tier 给正文或占位&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-snap"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="325" y="220" width="220" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;相关性分类&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;小 LLM + 特征；LR 后保序校准&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-g6"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="325" y="340" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;G6Result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;p_media_content · p_related · kind · engagement&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-g6o"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="325" y="450" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;专名纠错&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;G6 后、G7 前；edits 只改 display&lt;/span&gt;" link="design-text.html#dd-g6" id="p06-n-fix"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="325" y="560" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;播放融合&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;声学 · G6 媒体分 · 场景；≥TAU_ISO 即隔离&lt;/span&gt;" link="design-text.html#dd-g7" id="p06-n-fuse"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="595" y="220" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;取最严 · 记全因&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;hit / miss / unknown / not_evaluated&lt;/span&gt;" link="design-text.html#dd-g7" id="p06-n-verd"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="595" y="330" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;接受档&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;都未命中；segment.final 后可见&lt;/span&gt;" link="design-text.html#dd-g7" id="p06-n-acc"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="595" y="450" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;隔离档&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;分歧 · 回放 · 播放；存 7 天、可放回&lt;/span&gt;" link="design-text.html#dd-g7" id="p06-n-iso"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="595" y="560" width="220" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;拒绝档&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;非语音 · 无语音；只留时长与原因&lt;/span&gt;" link="design-text.html#dd-g7" id="p06-n-rej"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="595" y="660" width="220" height="56" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;写入资格&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;产物 × 四维：pass / fail / unknown / deferred&lt;/span&gt;" link="design-text.html#dd-g7" id="p06-n-elig"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="595" y="760" width="220" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;单元调度器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;每用户单写者 · 会议 / 10 分钟静默 / 换组&lt;/span&gt;" link="design-text.html#dd-unit" id="p06-n-usch"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="220" width="180" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;单元关闭&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;覆盖终结或等满 2 h；冻结 engagement；生成门槛&lt;/span&gt;" link="design-text.html#dd-unit" id="p06-n-ucl"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="330" width="180" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;立即同步截点&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;SyncCut 临时关；10 分钟内续说就重开&lt;/span&gt;" link="design-text.html#dd-unit" id="p06-n-cut"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="450" width="180" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;单元重开&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;代次 +1；旧产物 suspended&lt;/span&gt;" link="design-text.html#dd-unit" id="p06-n-ureo"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="660" width="180" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;言语行为抽取&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;读单元参与者片段；中 LLM；必须带跨度&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-ext"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1095" y="330" width="190" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;关系与状态&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;自动绑定 ≥0.90 且领先 ≥0.15&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-bind"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1095" y="450" width="190" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;期限解析&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;以发言当地自然日为锚；规则带版本&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-ddl"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1095" y="560" width="190" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;逐字段核验 · 派生&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;蕴含 TAU_ENT 0.90 + 四维；代码派生类别、核实状态、reminder_mode&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-ver"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1095" y="660" width="190" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;纪要&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;核实条目写成、逐条复核；隔离只占位&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-sum"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1335" y="210" width="230" height="56" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;待办 · 承诺&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;accept | commit · 按 modality；condition 未解析不提醒&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-todo"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1335" y="290" width="230" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;记忆候选&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;只自动接受本人事实&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-mem"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1335" y="380" width="230" height="56" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CommitOutputs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;原子发布；拒绝 stale / erased / source_expired&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-co"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1335" y="480" width="230" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;溯源&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;展示引用 + 计算依赖（act_id）&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-prov"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1335" y="600" width="230" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;存为我的待办&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;新身份条目 · 带 erasure_lineage&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-own"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1335" y="760" width="230" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;App 时间线&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;接受档正常显示；隔离档折叠并标原因&lt;/span&gt;" link="text.html#s5-down" id="p06-n-app"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="45" y="950" width="200" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;用户操作&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;放回 · 降级 · 改标 · 改字 · 点选 · 参与者&lt;/span&gt;" link="design-text.html#dd-g7" id="p06-n-ua"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="950" width="200" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;ConfirmOutput&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;只确认所选字段 → user_confirmed&lt;/span&gt;" link="design-text.html#dd-g8" id="p06-n-cf"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="610" y="950" width="200" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;xinli 业务线&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;原文与派生在业务库&lt;/span&gt;" link="../../adr/0050-capture-text-in-the-business-line.md" id="p06-n-x1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="1000" width="180" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;内核 attested 页&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;结构化页 · 平台渲染 · 写日志前审核&lt;/span&gt;" link="../../design/captures.md" id="p06-n-x2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="1140" width="180" height="70" as="geometry"/></mxCell></UserObject><mxCell id="p06-_24" value="详设没有定义产物如何进入业务线与内核；此列按 ADR-0050 只标边界。" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;spacing=4;" vertex="1" parent="1"><mxGeometry x="865" y="1240" width="180" height="140" as="geometry"/></mxCell><mxCell id="p06-n-s0" value="无" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1100" y="950" width="70" height="36" as="geometry"/></mxCell><mxCell id="p06-n-rq" value="requested" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1230" y="950" width="110" height="36" as="geometry"/></mxCell><mxCell id="p06-n-ak" value="acknowledged" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1420" y="950" width="130" height="36" as="geometry"/></mxCell><mxCell id="p06-n-cd" value="conditional" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1100" y="1080" width="110" height="36" as="geometry"/></mxCell><mxCell id="p06-n-ac" value="active" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="1080" width="90" height="36" as="geometry"/></mxCell><mxCell id="p06-n-dc" value="declined" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1460" y="1080" width="90" height="36" as="geometry"/></mxCell><mxCell id="p06-n-wd" value="withdrawn" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1100" y="1210" width="110" height="36" as="geometry"/></mxCell><mxCell id="p06-n-cp" value="completed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="1210" width="110" height="36" as="geometry"/></mxCell><mxCell id="p06-_26" value="requested / acknowledged 都可 accept、reject；原请求者 revoke → withdrawn。任意状态：绑定有歧义（领先 &amp;lt;0.15）或 amend 不明确 → conflicted；revoke 不是原行为人说的 → 不变，记 unresolved_revocation。只有 active 且四维全过、无冲突、无抽取缺口、期限明确、条件已满足才可能提醒。" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1095" y="1265" width="475" height="130" as="geometry"/></mxCell><mxCell id="p06-_27" value="规则摘要&lt;br&gt;· G6 快照只引用 base_rev；display-only 修订不改变 G6 输入，G6 结果复用并重绑引用版本。&lt;br&gt;· acoustic_tier 在 PersistResult 时派生并保存，G6 上下文据它给邻段正文或占位，不依赖 G6 输出，因此不成环。&lt;br&gt;· 用户改字与模型编辑重叠时，把编辑后的整块提升为用户编辑（如“张三 → 张大三”），未改的前后缀保留。&lt;br&gt;· evidence_rev 变化直接唤醒已隔离目标的 base 快照；快照依赖范围变化同样唤醒。&lt;br&gt;· undetermined 与背景不进纪要上下文；未知说话人不能支撑任何待办。&lt;br&gt;· 生成门槛先查是否仍有有效来源：不足时 generation_gate = sources_expired，单元以无纪要产物转 published。&lt;br&gt;· CommitOutputs 在同一事务里复核来源未到期；到期则 source_expired，按剩余来源产生新修订重新生成。&lt;br&gt;· G8 作业幂等键 (unit_id, generation, input_revision, pipeline_version)。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="810" height="320" as="geometry"/></mxCell><mxCell id="p06-_11" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="452" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_12" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="562" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_13" value="G6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="317" y="330" width="34" height="20" as="geometry"/></mxCell><mxCell id="p06-_14" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="526" y="342" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_15" value="G7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="587" y="320" width="34" height="20" as="geometry"/></mxCell><mxCell id="p06-_16" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="796" y="452" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_17" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="796" y="562" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_18" value="G8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1087" y="320" width="34" height="20" as="geometry"/></mxCell><mxCell id="p06-_19" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1266" y="332" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_20" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1546" y="212" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_21" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1546" y="292" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_22" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1546" y="382" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_23" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1546" y="762" width="17" height="16" as="geometry"/></mxCell><mxCell id="p06-_28" value="作业提交" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#2f6db5;strokeWidth=2;exitX=0.4792;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4792;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p06-n-up" target="p06-n-persist"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p06-_29" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;exitX=0.4792;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4792;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p06-n-persist" target="p06-n-atier"><mxGeometry x="0.0" relative="1" as="geometry"><