、日志、缓存），再报 ack-local" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaeb;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="268" y="224" width="360" height="26" as="geometry"/></mxCell><mxCell id="p07-_26" value="手机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaeb;strokeColor=#cfd8dc;fontSize=11;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="628" y="224" width="44" height="26" as="geometry"/></mxCell><mxCell id="p07-_27" value="🔒" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaeb;strokeColor=#cfd8dc;fontSize=11;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="672" y="224" width="40" height="26" as="geometry"/></mxCell><mxCell id="p07-_28" value="短期音频桶" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="112" height="40" as="geometry"/></mxCell><mxCell id="p07-_29" value="加密分片对象" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="132" y="250" width="136" height="40" as="geometry"/></mxCell><mxCell id="p07-_30" value="落盘后立即删，授权过期后最后清扫；兜底 72 h（从首次存入起算，重传不续期）；无版本、不备份" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="268" y="250" width="360" height="40" as="geometry"/></mxCell><mxCell id="p07-_31" value="云端" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=center;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="628" y="250" width="44" 