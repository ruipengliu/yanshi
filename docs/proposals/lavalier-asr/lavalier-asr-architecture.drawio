tml=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1035" y="784.5" as="sourcePoint"/><mxPoint x="1515" y="784.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p07-_155" value="GET /v1/erasures/{id}：三端进度" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="800" y="813.5" as="sourcePoint"/><mxPoint x="1035" y="813.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p07-_157" value="依赖的自动产物转 suspended（同一事务）" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1035" y="901.5" as="sourcePoint"/><mxPoint x="1160" y="901.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p07-_158" value="CommitOutputs 被拒：source_expired" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1395" y="930.5" as="sourcePoint"/><mxPoint x="1160" y="930.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p08" name="08 云端识别与判定详图"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1638" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p08-_3" value="作业进程内存：PCM、VAD 概率、CTC 后验、嵌入只在这里 · 需要音频，① 后删除" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcf0f0;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#b85450;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="220" y="84" width="1120" height="928" as="geometry"/></mxCell><mxCell id="p08-_4" value="目标一 · 标记无效语音：非语音不送识别、删无声插入、标出幻觉与回放" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="112" width="1100" height="280" as="geometry"/></mxCell><mxCell id="p08-_5" value="目标二 · 准确转写：偏置 → 主识别 → 对齐与支持 → 交叉校验 → 候选" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="402" width="1100" height="300" as="geometry"/></mxCell><mxCell id="p08-_6" value="目标三 · 识别说话人：分段 → 聚类 → 字落轮次 → 日内簇 → 机主三档" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="712" width="1100" height="290" as="geometry"/></mxCell><mxCell id="p08-_7" value="① 之后：片段库与裁决（只读文字、标量）" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#9673a6;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1440" y="84" width="340" height="928" as="geometry"/></mxCell><mxCell id="p08-_8" value="输入与配置（读）" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#d79b00;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="190" height="928" as="geometry"/></mxCell><mxCell id="p08-_9" value="说话人与覆盖账存储" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="1032" width="920" height="200" as="geometry"/></mxCell><mxCell id="p08-_1" value="&lt;b&gt;08 云端识别与判定：标记无效语音 · 准确转写 · 识别说话人&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1760" height="34" as="geometry"/></mxCell><mxCell id="p08-_2" value="一个音频作业在内存里跑完 G2–G5（D37），按三个目标分三行；落盘 ① 之后只剩文字与标量，由 G6 / G7 裁决。下方是作业读写的存储，模型池见 04。" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1760" height="22" as="geometry"/></mxCell><mxCell id="p08-_46" value="目标" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#37474f;fontColor=#ffffff;fontSize=12;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="1282" width="160" height="28" as="geometry"/></mxCell><mxCell id="p08-_47" value="判断（闸门）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#37474f;fontColor=#ffffff;fontSize=12;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="180" y="1282" width="190" height="28" as="geometry"/></mxCell><mxCell id="p08-_48" value="作业内证据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#37474f;fontColor=#ffffff;fontSize=12;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="370" y="1282" width="480" height="28" as="geometry"/></mxCell><mxCell id="p08-_49" value="落盘 ① 写什么" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#37474f;fontColor=#ffffff;fontSize=12;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="850" y="1282" width="450" height="28" as="geometry"/></mxCell><mxCell id="p08-_50" value="G7 与下游处置" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#37474f;fontColor=#ffffff;fontSize=12;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1300" y="1282" width="480" height="28" as="geometry"/></mxCell><mxCell id="p08-_51" value="无效语音 · 非语音" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1310" width="160" height="42" as="geometry"/></mxCell><mxCell id="p08-_52" value="G2 VAD 复核" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="180" y="1310" width="190" height="42" as="geometry"/></mxCell><mxCell id="p08-_53" value="speech_raw 加余量得 keep；有效音频里 keep 的补集为 non_speech；损坏、补零记 unknown（不当语音也不当静音）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="370" y="1310" width="480" height="42" as="geometry"/></mxCell><mxCell id="p08-_54" value="不送 8B、不生成片段；覆盖账记 non_speech（整段非语音也能闭合、驱动删除）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="850" y="1310" width="450" height="42" as="geometry"/></mxCell><mxCell id="p08-_55" value="拒绝：没有文字（v-nonspeech）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="1300" y="1310" width="480" height="42" as="geometry"/></mxCell><mxCell id="p08-_56" value="无效语音 · 无声插入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1352" width="160" height="30" as="geometry"/></mxCell><mxCell id="p08-_57" value="G4 无语音拒绝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="180" y="1352" width="190" height="30" as="geometry"/></mxCell><mxCell id="p08-_58" value="对齐可靠（时间不确定 ≤300 ms）的连续 ≥2 个字落在非语音、保守语音掩码之外" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="370" y="1352" width="480" height="30" as="geometry"/></mxCell><mxCell id="p08-_59" value="落盘前从 asr_text、候选与坐标映射删掉该跨度，片段只留时长与原因" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="850" y="1352" width="450" height="30" as="geometry"/></mxCell><mxCell id="p08-_60" value="拒绝该跨度（v-nohall），其余照常裁决" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="1300" y="1352" width="480" height="30" as="geometry"/></mxCell><mxCell id="p08-_61" value="无效语音 · 模型幻觉" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1382" width="160" height="30" as="geometry"/></mxCell><mxCell id="p08-_62" value="G4 交叉校验" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="180" y="1382" width="190" height="30" as="geometry"/></mxCell><mxCell id="p08-_63" value="幻觉型规则（重复、字速、zlib、短语、语种突变）触发，且 600M 独立解码分歧大" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="370" y="1382" width="480" height="30" as="geometry"/></mxCell><mxCell id="p08-_64" value="acoustic_tier = 隔离，原因与分歧随片段保存" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="850" y="1382" width="450" height="30" as="geometry"/></mxCell><mxCell id="p08-_65" value="隔离 7 天、可放回（v-disagree）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="1300" y="1382" width="480" height="30" as="geometry"/></mxCell><mxCell id="p08-_66" value="无效语音 · 疑似回放" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1412" width="160" height="30" as="geometry"/></mxCell><mxCell id="p08-_67" value="G5 + G3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="180" y="1412" width="190" height="30" as="geometry"/></mxCell><mxCell id="p08-_68" value="owner_score ≥T_high、本机外放覆盖、纯声学回放分 ≥0.9 且区间覆盖 ≥0.8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="370" y="1412" width="480" height="30" as="geometry"/></mxCell><mxCell id="p08-_69" value="replay.suspected 与证据区间；回放轮次撤销簇贡献" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="850" y="1412" width="450" height="30" as="geometry"/></mxCell><mxCell id="p08-_70" value="隔离（v-replay）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="1300" y="1412" width="480" height="30" as="geometry"/></mxCell><mxCell id="p08-_71" value="无效语音 · 播放与媒体" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1442" width="160" height="42" as="geometry"/></mxCell><mxCell id="p08-_72" value="G3 → G6 → G7 融合" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="180" y="1442" width="190" height="42" as="geometry"/></mxCell><mxCell id="p08-_73" value="片段级纯声学分、1 s 证据区间、混合、媒体底噪；G6 的媒体与相关分；场景（免提时屏蔽外放）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="370" y="1442" width="480" height="42" as="geometry"/></mxCell><mxCell id="p08-_74" value="G3 片段级标量与 1 s 区间（窗口概率随作业丢弃）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="850" y="1442" width="450" height="42" as="geometry"/></mxCell><mxCell id="p08-_75" value="融合 ≥TAU_ISO 按区间隔离（v-playback）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="1300" y="1442" width="480" height="42" as="geometry"/></mxCell><mxCell id="p08-_76" value="准确转写" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1484" width="160" height="42" as="geometry"/></mxCell><mxCell id="p08-_77" value="8B + 偏置 → 600M → G4 → 候选" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="180" y="1484" width="190" height="42" as="geometry"/></mxCell><mxCell id="p08-_78" value="冻结的每窗偏置表；600M 强制对齐与支持分；交叉解码；音系召回与同区间声学评分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="370" y="1484" width="480" height="42" as="geometry"/></mxCell><mxCell id="p08-_79" value="asr_text 原文不覆盖；low_support_spans、qualification_blocks；候选与标量证据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="850" y="1484" width="450" height="42" as="geometry"/></mxCell><mxCell id="p08-_80" value="低支持只标记；纠错默认关、只改 display；关键字段与低支持相交则不能进已核实待办" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="1300" y="1484" width="480" height="42" as="geometry"/></mxCell><mxCell id="p08-_81" value="识别说话人" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1526" width="160" height="42" as="geometry"/></mxCell><mxCell id="p08-_82" value="G5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="180" y="1526" width="190" height="42" as="geometry"/></mxCell><mxCell id="p08-_83" value="分段与轨迹、批内聚类、字落轮次、日内簇证据（扣除本轮）、AS-norm + 校准" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="370" y="1526" width="480" height="42" as="geometry"/></mxCell><mxCell id="p08-_84" value="speaker（owner / other / unknown）、evidence_grade、按归属切分的片段、簇增量" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="850" y="1526" width="450" height="42" as="geometry"/></mxCell><mxCell id="p08-_85" value="未知不隔离；记忆要证据级或用户确认的机主；改标为机主不更新声纹" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#cfd8dc;fontSize=11;align=left;verticalAlign=middle;spacingLeft=5;spacingRight=3;" vertex="1" parent="1"><mxGeometry x="1300" y="1526" width="480" height="42" as="geometry"/></mxCell><UserObject label="&lt;b&gt;解码&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;按 runs 解 Ogg Opus · 校验 sha256 · 裁 pre_skip，缺尾补零记 concealed&lt;/span&gt;" link="design-asr.html#dd-g2" id="p08-n-dec"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="245" y="142" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;VAD 复核&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;中值 50 ms · 滞回 0.60 / 0.35 · 短峰 ≥0.85 保留&lt;/span&gt;" link="design-asr.html#dd-g2" id="p08-n-vad"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="430" y="142" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;三类区间&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;speech_raw · keep（前 400 / 后 700 ms）· non_speech · unknown&lt;/span&gt;" link="design-asr.html#dd-g2" id="p08-n-mask"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="615" y="142" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;非语音 → 拒绝&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;不送 8B · 不生成片段 · 覆盖账记 non_speech&lt;/span&gt;" link="design-asr.html#dd-g2" id="p08-n-ns"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="142" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;无声插入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;可靠对齐的连续 ≥2 字落在非语音 → 删跨度&lt;/span&gt;" link="design-asr.html#dd-g4" id="p08-n-nohall"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="142" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;acoustic_tier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;非语音 · 无声插入 · 分歧 · 回放取最严；不含播放融合&lt;/span&gt;" link="design-text.html#dd-g6" id="p08-n-atier"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="142" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;播放检测&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;3 s 窗 · LFCC · 混合 · 媒体底噪；只打标签&lt;/span&gt;" link="design-asr.html#dd-g3" id="p08-n-g3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="430" y="290" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;片段级聚合&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;按 G5 轮次 · 1 s 证据区间 · 有效覆盖&lt;/span&gt;" link="design-asr.html#dd-g3" id="p08-n-g3s"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="290" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;幻觉 + 大分歧&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;重复 · 字速 · zlib · 短语 · 语种突变，且交叉分歧大 → 隔离&lt;/span&gt;" link="design-asr.html#dd-g4" id="p08-n-dis"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="290" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;疑似回放&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≥T_high · 本机外放 · 纯声学 ≥0.9；≥2 s 轮次另需区间覆盖 ≥0.8&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-rep"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="290" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;识别窗口&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≥300 ms 停顿切 · 15–45 s · 强切留 400 ms 上下文&lt;/span&gt;" link="design-asr.html#dd-g2" id="p08-n-win"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="245" y="436" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;每窗偏置表&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;核心区录音时刻构表 · ≤300 条 · 2048 token&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p08-n-bias"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="245" y="600" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;8B 转写&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;每窗一次 · 剪枝前偏置 · 束宽 8 · 不顺滑不 ITN&lt;/span&gt;" link="design-asr.html#dd-8b" id="p08-n-asr"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="430" y="436" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;600M 对齐 · 支持&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;全量 CTC 强制对齐 · g_frame / g_label · 核心区去重&lt;/span&gt;" link="design-asr.html#dd-g4" id="p08-n-aux"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="615" y="436" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;初筛 · 交叉解码&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;8B 原文先做文本初筛，合并 600M 证据后才决定独立解码（不带偏置，约 20%）&lt;/span&gt;" link="design-asr.html#dd-g4" id="p08-n-chk"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="436" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;低支持 · 低置信&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;只标记 flag，附 ≤3 个候选；不算幻觉&lt;/span&gt;" link="design-asr.html#dd-g4" id="p08-n-flag"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="436" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;候选区间&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;专名 · 分歧 · 低支持；中文 1–8 字&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p08-n-span"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="615" y="600" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;音系召回&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;全量词库 · 相似度 ≥0.75（个人 0.85）· ≤20 条&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p08-n-rec"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;同区间声学评分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;复用 600M 后验 · CTC 前向概率 · 只存标量&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p08-n-sc"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="600" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;片段文字与证据&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;asr_text 原文不覆盖&lt;br&gt;low_support_spans&lt;br&gt;qualification_blocks&lt;br&gt;候选 + 标量证据&lt;br&gt;（无声插入跨度已删）&lt;/span&gt;" link="design-asr.html#dd-g4" id="p08-n-txt"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="436" width="150" height="244" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;重叠感知分段&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;Powerset：无人 / 单人 / 重叠 · 槽位连成轨迹&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-seg"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="245" y="746" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;干净片段嵌入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;排除重叠与边界 · 只在内存&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-emb"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="430" y="746" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;批内聚类 · 重分段&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;约束 AHC 0.95 · 排除声学回放 ≥20% 的轮次&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-ahc"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="615" y="746" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;字落轮次&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;对齐帧加权覆盖 ≥0.8、领先 0.2；重叠 → 未知&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-char"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="746" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;日内关联&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;0.98 且领先 ≥0.1 · 簇证据扣除本轮&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-day"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="746" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;机主打分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;AS-norm（top-200）+ 校准 → owner_score&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-own"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="896" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;三档 · 证据级&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;证据级须单人 ≥1 s 且 600M 对齐；无声纹 → 未知&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-tier"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="746" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;簇增量&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≥1.5 s 干净片段 · 权重 ≤8 · 回放轮次撤销&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-cup"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="896" width="150" height="80" as="geometry"/></mxCell></UserObject><mxCell id="p08-_34" value="宁可未知，不可错人：重叠与边界模糊只把该区间记未知；一期单麦、无 VPU，重叠的字不分给两人。簇目录或声纹版本冲突时只重做关联与判定，不重新解码。" style="html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#444444;spacing=4;rounded=1;arcSize=4;strokeColor=#bdbdbd;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="245" y="896" width="520" height="84" as="geometry"/></mxCell><UserObject label="&lt;b&gt;落盘 ① PersistResult&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;片段 · 覆盖账 · 簇增量与目录 rev 同一事务；校验 lease_epoch · exec_gen · bias_table_refs · 声纹 epoch · erasure_epoch；之后不再有声学计算&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p08-n-pr"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;horizontal=0;" vertex="1" parent="1"><mxGeometry x="1360" y="112" width="64" height="890" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;片段库 segments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;接受 · 隔离（7 天）· 拒绝（只留时长与原因）；scores · speaker · 候选 · acoustic_tier&lt;/span&gt;" link="platform.html#s7" id="p08-n-segs"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="1455" y="124" width="310" height="96" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;相关性&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;媒体内容 · 相关分&lt;/span&gt;" link="design-text.html#dd-g6" id="p08-n-g6"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1455" y="270" width="148" height="74" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;可弃权重排&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;G6 后 G7 前 · 默认关 · 只改 display&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p08-n-rr"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1617" y="270" width="148" height="74" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;播放融合&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;声学分与区间 · 混合 · 媒体底噪 · G6 · 场景 → ≥TAU_ISO（0.95 起扫）&lt;/span&gt;" link="design-text.html#dd-g7" id="p08-n-fus"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1455" y="390" width="310" height="74" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;三档裁决&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;非语音 · 无声插入 → 拒绝；分歧 · 疑似回放 · 播放融合 → 隔离；取最严，原因记 hit / miss / unknown / not_evaluated；低置信、说话人未知不单独隔离&lt;/span&gt;" link="design-text.html#dd-g7" id="p08-n-g7"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1455" y="510" width="310" height="110" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;接受&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;可带缺证据标记&lt;/span&gt;" link="design-text.html#dd-g7" id="p08-n-acc"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1455" y="666" width="98" height="84" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;隔离&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;存文字 7 天 · 可放回&lt;/span&gt;" link="design-text.html#dd-g7" id="p08-n-iso"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1561" y="666" width="98" height="84" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;拒绝&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;不存文字&lt;/span&gt;" link="design-text.html#dd-g7" id="p08-n-rej"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1667" y="666" width="98" height="84" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;写入资格（四维）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;身份 · 文字可靠性 · 相关性 · 语义支持；600M 缺失时文字可靠性记 unknown，已核实待办与记忆不过&lt;/span&gt;" link="design-text.html#dd-g7" id="p08-n-elig"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1455" y="790" width="310" height="96" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;删除链&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;chunk.deletable（只带 ID）→ 删对象与 K → 回执（见 07）&lt;/span&gt;" link="design-text.html#dd-delete" id="p08-n-del"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1455" y="920" width="310" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;短期音频桶&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;加密分片 · 识别完即删 · 72 h 强删&lt;/span&gt;" link="platform.html#s5-12" id="p08-n-s_obj"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="30" y="136" width="170" height="104" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;清单 · 场景&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;payload.runs · L1 标签 · 外放 / 通话场景 · tz&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p08-n-s_man"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="30" y="282" width="170" height="104" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;RecJob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;plan（G2 提议、CommitPlan 冻结）· ExecConfig.bias_tables · exec_gen&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p08-n-s_job"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="170" height="104" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;热词库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;个人 / 行业 / 公共 · 音系索引；BuildBias 写入 RecJob，撤权经 RebindExec 换代&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p08-n-s_hot"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="30" y="596" width="170" height="104" as="geometry"/></mxCell></UserObject><mxCell id="p08-_41" value="线型与图标见 00 页：红粗线为音频，蓝为文字，灰虚线为控制与写入，黄点线为读取。" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="170" height="120" as="geometry"/></mxCell><UserObject label="&lt;b&gt;日内簇 · 目录&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;未单位化均值 · rev · 业务日结束 +12 h 删&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-s_clu"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="900" y="1082" width="170" height="108" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;声纹库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;单模板 · version / epoch · 用户密钥加密&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p08-n-s_vp"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="1100" y="1082" width="160" height="108" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;校准器 · 冒认者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;1000 人 · top-200；模型、阈值、校准器分别版本化&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p08-n-s_cal"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="1290" y="1082" width="170" height="108" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;覆盖账&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;整帧 outcome：recognized · non_speech · l1_dropped · source_gap · cloud_failed · erased&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p08-n-s_cov"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="1500" y="1082" width="250" height="108" as="geometry"/></mxCell></UserObject><mxCell id="p08-_44" value="&lt;b style=&quot;font-size:13px&quot;&gt;关键数据结构（只在内存的标 *）&lt;/b&gt;&lt;br&gt;&lt;b&gt;G2Result*&lt;/b&gt;：speech_raw · keep · non_speech · unknown · windows · proposal&lt;br&gt;&lt;b&gt;G3Seg&lt;/b&gt;：p_playback_acoustic / fused · playback_acoustic_spans · mixed / media_spans（1 s）· valid_coverage&lt;br&gt;&lt;b&gt;HealthDecision&lt;/b&gt;：action pass / flag / quarantine / reject · reasons · low_confidence_spans · qualification_blocks&lt;br&gt;&lt;b&gt;CharAttribution&lt;/b&gt;：char_from / to · turn_key · assigned / ambiguous / unaligned · score · runner_up&lt;br&gt;&lt;b&gt;SpeakerDecision&lt;/b&gt;：owner / other / unknown · cluster_id · 三个分数 · evidence_grade · replay{suspected, spans}" style="html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;spacing=4;rounded=1;arcSize=4;strokeColor=#bdbdbd;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="1032" width="820" height="200" as="geometry"/></mxCell><mxCell id="p08-_45" value="三个目标：证据 → 落盘 → 处置" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1250" width="1000" height="26" as="geometry"/></mxCell><mxCell id="p08-_86" value=