 height="400" as="geometry"/></mxCell><mxCell id="p05-_7" value="偏置表" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#d79b00;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="510" width="330" height="370" as="geometry"/></mxCell><mxCell id="p05-_8" value="专名纠错" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#9673a6;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1270" y="90" width="310" height="790" as="geometry"/></mxCell><mxCell id="p05-_1" value="&lt;b&gt;05 机主判定与热词：G5 · 声纹 · 日内簇 · 偏置表 · 专名纠错&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1560" height="34" as="geometry"/></mxCell><mxCell id="p05-_2" value="G5 在作业进程内、删音频之前完成；热词表按窗口冻结进 ExecConfig.bias_tables，撤权经 RebindExec 换代（D80）。灰框是 04 页的输入。" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1560" height="22" as="geometry"/></mxCell><UserObject label="&lt;b&gt;同意 · 挑战下发&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;单独同意；一次性 nonce · 3 段朗读 + 3 段开放回答&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p05-n-e1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="45" y="140" width="230" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;领夹实时录制&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;只收领夹经 BLE 的帧&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p05-n-e2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="45" y="250" width="230" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;逐段检查&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≥3 s · SNR ≥15 dB · 内容匹配 ≥0.9 · 回放&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p05-n-e3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="45" y="360" width="230" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;一致性 · 激活&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;留一 ≥0.99；CAS 使 epoch +1，注册音频即删&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p05-n-e4"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="45" y="470" width="230" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;声纹模板&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;单模板 · 用户密钥加密 · version / epoch&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p05-n-v1"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="45" y="650" width="230" height="90" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;漂移统计&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;每天 P10 / P50；只提示重新注册&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p05-n-v2"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="45" y="770" width="230" height="70" as="geometry"/></mxCell></UserObject><mxCell id="p05-n-in_pcm" value="04 · 解码后 PCM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="125" width="160" height="50" as="geometry"/></mxCell><mxCell id="p05-n-in_al" value="04 · 600M 字对齐" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="535" y="125" width="160" height="50" as="geometry"/></mxCell><mxCell id="p05-n-in_g3" value="04 · G3 声学 · 场景" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="725" y="125" width="160" height="50" as="geometry"/></mxCell><UserObject label="&lt;b&gt;分段 · 嵌入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;Powerset：无人 / 单人 / 重叠；嵌入排除重叠&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="220" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;字落轮次&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;加权覆盖 · assign_min 0.8 · margin 0.2&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="535" y="220" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;局部复核&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;变体：有效语音 ×5% 预算 · 每区间最多一轮&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g9"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="725" y="790" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;批内聚类&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;约束 AHC 0.95 · 只用 ≥1.5 s 干净片段&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="330" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;日内关联&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;读簇与目录 rev · 0.98 且领先 ≥0.1&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g4"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="440" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;机主打分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;簇证据 + AS-norm top-200 + 校准 → owner_score&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g5"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="535" y="440" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;三档分档&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;T_low / T_high / T_evidence（占位）&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g6"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="725" y="440" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;疑似回放&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≥T_high + 本机外放 + 声学 ≥0.9&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g7"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="725" y="330" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;同事务落盘 ①&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;片段 + 簇增量；校验目录 rev 与 epoch&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-g8"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="535" y="690" width="160" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;日内簇&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;未单位化均值 · 总权重；业务日 +12 h 删&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-c1"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="345" y="560" width="160" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;簇目录&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;每业务日（04:00 起）一个 rev&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p05-n-c2"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="345" y="780" width="160" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;词条同步&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;hotwords:sync · 删除留墓碑&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p05-n-h1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="150" height="70" as="geometry"/></mxCell></UserObject><mxCell id="p05-n-in_app" value="App 改字 · 通讯录 · 日历" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1110" y="140" width="120" height="70" as="geometry"/></mxCell><UserObject label="&lt;b&gt;三类词库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;个人 / 行业 / 公共；包整体发布&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p05-n-h2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="260" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;音系索引&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;拼音 / 音素 n-gram · ≤4 条读音&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p05-n-h3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="380" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;构建偏置表&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;每窗：录音时刻、会议、行业包；300 条 · 2048 token&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p05-n-b1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;偏置表缓存&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;完整键含 erasure_epoch · ≤1 h&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p05-n-b2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="700" width="150" height="70" as="geometry"/></mxCell></UserObject><mxCell id="p05-n-in_job" value="04 · RecJob
ExecConfig.
bias_tables" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1115" y="600" width="115" height="120" as="geometry"/></mxCell><mxCell id="p05-n-in_8b" value="04 · 8B 原文" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="125" width="250" height="50" as="geometry"/></mxCell><UserObject label="&lt;b&gt;候选区间&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;专名 · 分歧 · 低支持；中文 1–8 字&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p05-n-f1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="220" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;音系召回&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;相似度 ≥0.75（个人 0.85）· 每区间 20 条&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p05-n-f2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="320" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;同区间声学评分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;CTC 前向概率 · 共同帧 · 左右各 2 token&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p05-n-f3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="420" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;片段库（G5 落盘后）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;候选与标量证据随片段保存（见 06）&lt;/span&gt;" link="design-text.html#dd-g6" id="p05-n-seg"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="1300" y="540" width="250" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;可弃权重排&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;G6 后、G7 前；默认关：{原文, 候选, 都不对}&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p05-n-f4"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="670" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;门槛 · 校验&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;默认关：TAU 0.95–0.98 · MARGIN 0.2 · 每段 ≤3 条&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p05-n-f5"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1300" y="780" width="250" height="70" as="geometry"/></mxCell></UserObject><mxCell id="p05-_22" value="&lt;b style=&quot;font-size:13px&quot;&gt;关键数据结构（design-speaker.html）&lt;/b&gt;&lt;br&gt;&lt;b&gt;ClusterState&lt;/b&gt;：day_id · cluster_id · mean_enc（未单位化、加密）· total_weight · n_contrib · rev · expires_at&lt;br&gt;&lt;b&gt;Voiceprint&lt;/b&gt;：version · epoch · template_enc · level_baseline_db · template_quality · status&lt;br&gt;&lt;b&gt;SpeakerDecision&lt;/b&gt;：label owner / other / unknown · 三个分数 · evidence_grade · replay{suspected, spans}&lt;br&gt;&lt;b&gt;HotwordEntry&lt;/b&gt;：scope · entity_type · surface · pronunciations · sources[有效期, generation] · status&lt;br&gt;&lt;b&gt;BiasTable&lt;/b&gt;：table_id = 内容哈希 · snapshot（各版本）· applicable_* · entries[surface, weight, reasons] · truncated&lt;br&gt;&lt;b&gt;CorrectionCandidate / Edit&lt;/b&gt;：span · to_text · retrieval{phonetic_sim} · acoustic{delta_per_frame} ／ start · end · from · to · p · evidence_version&lt;br&gt;&lt;b&gt;状态机&lt;/b&gt;：注册 CREATED → CONSENTED → CHALLENGING → QUALITY_CHECKED → TEMPLATE_READY → ACTIVATED → AUDIO_PURGED；词条 RECEIVED → ACTIVE（UPDATED / REVOKED / EXPIRED）" style="html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;spacing=4;rounded=1;arcSize=4;strokeColor=#bdbdbd;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="980" height="340" as="geometry"/></mxCell><mxCell id="p05-_23" value="参数&lt;br&gt;字归属 0.8 / margin 0.2，边界保护 100 ms。&lt;br&gt;簇更新最短 1.5 s；扣除自身后 ≥10 s 才启用簇级分。&lt;br&gt;聚类同人概率 0.95，日内关联 0.98、领先 ≥0.1。&lt;br&gt;三档 0.1 / 0.99 / 0.995 为占位；一期取选择集上零误判的最低阈值，只报点估计与人级上界（D69）。&lt;br&gt;回放 REPLAY_P 0.9、REPLAY_COVER 0.8。&lt;br&gt;注册 3+3 段、每段 ≥3 s、总 ≥35 s。&lt;br&gt;偏置表 300 条（行业 ≥60、公共 ≥20、个人 ≤220）、2048 token；日历词在会议前后 ±30 min 生效。&lt;br&gt;二期：VPU × 声纹融合（G5 一期没有 VPU）。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="900" width="560" height="340" as="geometry"/></mxCell><mxCell id="p05-_9" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="252" width="17" height="16" as="geometry"/></mxCell><mxCell id="p05-_10" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="362" width="17" height="16" as="geometry"/></mxCell><mxCell id="p05-_11" value="🔒" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="472" width="17" height="16" as="geometry"/></mxCell><mxCell id="p05-_