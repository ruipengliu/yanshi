row=none;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="850" y="130" as="sourcePoint"/><mxPoint x="850" y="1181" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p03-_71" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;dashPattern=4 4;endArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1120" y="130" as="sourcePoint"/><mxPoint x="1120" y="1181" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p03-_1" value="&lt;b&gt;03 链路时序：领夹 ↔ 手机 ↔ 云端&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1560" height="34" as="geometry"/></mxCell><mxCell id="p03-_2" value="一次重连后的完整过程。顺序以 design-device.html#dd-link / #dd-stage 为准；RESUME 之前领夹只处理 CMD 与 TIME_REQ（D81）。" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1560" height="22" as="geometry"/></mxCell><mxCell id="p03-_63" value="① 连接与清账" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacingLeft=8;fontColor=#37474f;" vertex="1" parent="1"><mxGeometry x="20" y="156" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p03-_64" value="② 补发 ACK 与校时" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacingLeft=8;fontColor=#37474f;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p03-_65" value="③ 突发传输与回执" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacingLeft=8;fontColor=#37474f;" vertex="1" parent="1"><mxGeometry x="20" y="477" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p03-_66" value="④ 封口与启动恢复" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacingLeft=8;fontColor=#37474f;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p03-_67" value="⑤ 上传与云端回执" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f4;strokeColor=none;fontSize=12;fontStyle=1;align=left;spacingLeft=8;fontColor=#37474f;" vertex="1" parent="1"><mxGeometry x="20" y="798" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p03-_3" value="领夹" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="135.0" y="90" width="110" height="40" as="geometry"/></mxCell><mxCell id="p03-_4" value="手机 App" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505.0" y="90" width="110" height="40" as="geometry"/></mxCell><mxCell id="p03-_5" value="手机暂存库 / 文件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="792.06" y="90" width="115.88" height="40" as="geometry"/></mxCell><mxCell id="p03-_6" value="云端" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1065.0" y="90" width="110" height="40" as="geometry"/></mxCell><mxCell id="p03-_7" value="落盘 / 状态变化" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="380" height="22" as="geometry"/></mxCell><mxCell id="p03-_10" value="手机记 encoder_delay，换算 pre_skip" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="215.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_12" value="cmd_seq 在 device_commands 持久分配；领夹收到先存 pending" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="244.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_14" value="掉电后按 pending / executing 继续" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="273.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_16" value="同一 cmd_id 重发：completed 才回" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="302.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_18" value="领夹核对 cmd_seq &amp;lt; cmd_upto 全部 completed，否则断开" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="331.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_20" value="处理“落盘了、ACK 丢了”" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="390.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_22" value="之后连接中每 5 min 一次" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="419.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_24" value="写 SyncSample，取 RTT 最短" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="448.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_27" value="按 (gen, seq) 升序；页为明文，链路已加密" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="536.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_29" value="AEAD 落盘并 fsync" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="565.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_31" value="只推进到连续前缀" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="594.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_33" value="D81：先持久化水位，再销毁" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="623.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_35" value="槽写 0 并读回 → KEY_ZEROED" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="652.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_37" value="空闲时擦除整块 → FREE" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="681.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_39" value="先回执、后封口的半块不必等新回执" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="740.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_41" value="收到 RESUME 之前不发 DATA" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="769.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_43" value="已有范围直接 ACK，不再上传" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="828.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_45" value="提交后才删 raw" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="857.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_48" value="stored / processing / done / deletion_pending → COMMITTED；deleted → finish" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="915.0" width="380" height="40" as="geometry"/></mxCell><mxCell id="p03-_50" value="直传地址 15 min 内有效" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="959.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_52" value="暂存库：COMMITTED" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="988.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_54" value="云端等直传过期并最后清扫后才发（见 07）" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="1017.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_56" value="request_id = sha256(receipt_id, install_id)；本机从未持有时 local_state = not_held、cleanup_done = true" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="1046.0" width="380" height="40" as="geometry"/></mxCell><mxCell id="p03-_58" value="当天分片全部终结则删 day_key" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="1090.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_60" value="清理完成后才发；重配对不改旧请求" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="1119.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_62" value="之后才可清 receipt_acks 与分片行" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="1148.0" width="380" height="25" as="geometry"/></mxCell><mxCell id="p03-_72" value="崩溃恢复" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1201" width="400" height="24" as="geometry"/></mxCell><mxCell id="p03-_73" value="收到 ACK、销毁前掉电：水位已落盘的，启动恢复按水位补做销毁；水位还没写的，手机重发同一 ACK，重复回执同样触发补做（幂等）。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1231" width="380" height="110" as="geometry"/></mxCell><mxCell id="p03-_74" value="先回执、后封口的半块：封口时按已持久化的水位调 zeroize_covered，不必等新回执。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="412" y="1231" width="380" height="110" as="geometry"/></mxCell><mxCell id="p03-_75" value="CMD 已持久化、擦除未完成时掉电：启动时按 pending / executing 继续；完成前对重发的同一 cmd_id 不回 CMD_DONE；收到 RESUME 前不发 DATA。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="804" y="1231" width="380" height="110" as="geometry"/></mxCell><mxCell id="p03-_76" value="receipt_acks 已记录、清理前崩溃：启动或再次收到回执时，对 cleanup_done = false 的记录恢复清理，再原样重发请求体；重配对后 receiver_epoch 变了也不改旧请求。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1196" y="1231" width="380" height="110" as="geometry"/></mxCell><mxCell id="p03-_13" value="executing：销毁覆盖块密钥并读回 → completed" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f3e6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="196" y="275.5" width="262.4" height="20" as="geometry"/></mxCell><mxCell id="p03-_25" value="请求短间隔 15–30 ms · 2M PHY" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f3e6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="196" y="509.5" width="178.13999999999993" height="20" as="geometry"/></mxCell><mxCell id="p03-_32" value="persist_acked：校验 epoch / crc / 越界 → 持久化删除许可水位" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f3e6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="196" y="625.5" width="341.81999999999994" height="20" as="geometry"/></mxCell><mxCell id="p03-_34" value="zeroize_covered(gen)：整块已覆盖的 SEALED 块" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f3e6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="196" y="654.5" width="273.0699999999999" height="20" as="geometry"/></mxCell><mxCell id="p03-_36" value="回长间隔 285–300 ms · 外设延迟 4 · 监督超时 5 s" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f3e6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="196" y="683.5" width="277.90999999999997" height="20" as="geometry"/></mxCell><mxCell id="p03-_38" value="封口（停录 / 世代结束）：WRITING → SEALED，立即 zeroize_covered" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f3e6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="196" y="742.5" width="391.2100000000002" height="20" as="geometry"/></mxCell><mxCell id="p03-_40" value="启动：封口遗留 WRITING → 各世代 zeroize_covered → 续未完成 CMD" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f3e6;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="196" y="771.5" width="383.4000000000001" height="20" as="geometry"/></mxCell><mxCell id="p03-_8" value="连接 · LE Secure Connections 绑定加密" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="190" y="203.5" as="sourcePoint"/><mxPoint x="560" y="203.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_9" value="HELLO：receiver_epoch · boot_gen · oldest/newest · encoder_delay · cmds_unfinished[]" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="190" y="232.5" as="sourcePoint"/><mxPoint x="560" y="232.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_11" value="CMD：cmd_id · cmd_seq · receiver_epoch · ERASE{gen, seq_from, seq_to}" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="261.5" as="sourcePoint"/><mxPoint x="190" y="261.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_15" value="CMD_DONE：cmd_id" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="190" y="319.5" as="sourcePoint"/><mxPoint x="560" y="319.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_17" value="RESUME：receiver_epoch · cmd_upto" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="348.5" as="sourcePoint"/><mxPoint x="190" y="348.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_19" value="ACK（补发）：已落盘且比 oldest 新的 (gen, seq_upto)" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="407.5" as="sourcePoint"/><mxPoint x="190" y="407.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_21" value="TIME_REQ ×8：req_id（手机记单调 m1 / m4）" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="436.5" as="sourcePoint"/><mxPoint x="190" y="436.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_23" value="TIME_RSP：r2 · r3 · 最近 (seq, rtc) 锚点" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="190" y="465.5" as="sourcePoint"/><mxPoint x="560" y="465.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_26" value="DATA ×N / GAP：gen · seq_first · rtc_first · n_frames · frames" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#c0504d;strokeWidth=3;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="190" y="553.5" as="sourcePoint"/><mxPoint x="560" y="553.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_28" value="写帧 + 锚点（主键去重）" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#c0504d;strokeWidth=3;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="582.5" as="sourcePoint"/><mxPoint x="850" y="582.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_30" value="ACK：receiver_epoch · gen · seq_upto（不含）· last_page_crc" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="611.5" as="sourcePoint"/><mxPoint x="190" y="611.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_42" value="换机时 GET /v1/chunks（device_id, boot_gen）" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="845.5" as="sourcePoint"/><mxPoint x="1120" y="845.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_44" value="封口 → L1 → 载荷（K 包裹）· 同事务写 PAYLOAD" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="874.5" as="sourcePoint"/><mxPoint x="850" y="874.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_46" value=":prepare（manifest, queue）" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#2f6db5;strokeWidth=2;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="903.5" as="sourcePoint"/><mxPoint x="1120" y="903.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_47" value="upload_url 或 state" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1120" y="940.0" as="sourcePoint"/><mxPoint x="560" y="940.0" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_49" value="PUT 载荷密文" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#c0504d;strokeWidth=3;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="976.5" as="sourcePoint"/><mxPoint x="1120" y="976.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_51" value=":commit（sha256 · bytes · k）" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="1005.5" as="sourcePoint"/><mxPoint x="1120" y="1005.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_53" value="receipt：receipt_id · chunk_id · audio_stage = cloud_deleted" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="1120" y="1034.5" as="sourcePoint"/><mxPoint x="560" y="1034.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_55" value="receipt_acks.insert：完整请求体 + cleanup_done" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="1071.0" as="sourcePoint"/><mxPoint x="850" y="1071.0" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_57" value="finish：删载荷、wrapped_k 置空 → mark_cleanup_done" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="1107.5" as="sourcePoint"/><mxPoint x="850" y="1107.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_59" value=":ack-local（原样请求体，local_state = removed | not_held）" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="1136.5" as="sourcePoint"/><mxPoint x="1120" y="1136.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="p03-_61" value="mark_acknowledged" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#222222;strokeColor=#7f7f7f;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="560" y="1165.5" as="sourcePoint"/><mxPoint x="850" y="1165.5" as="targetPoint"/><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p04" name="04 云端识别作业"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p04-_3" value="上传接收" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="200" height="640" as="geometry"/></mxCell><mxCell id="p04-_4" value="拼接器（每用户单写者）" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="250" height="480" as="geometry"/></mxCell><mxCell id="p04-_5" value="两级队列与租约" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="240" height="480" as="geometry"/></mxCell><mxCell id="p04-_6" value="关联服务" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="590" width="510" height="140" as="geometry"/></mxCell><mxCell id="p04-_7" value="音频作业进程" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="90" width="560" height="640" as="geometry"/></mxCell><mxCell id="p04-_8" value="进程内存：PCM、VAD、嵌入只在内存，作业结束即弃" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcf0f0;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#b85450;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="785" y="125" width="530" height="455" as="geometry"/></mxCell><mxCell id="p04-_9" value="模型池" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f0f5fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1350" y="90" width="230" height="640" as="geometry"/></mxCell><mxCell id="p04-_30" value="作业与对象状态" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="760" width="660" height="515" as="geometry"/></mxCell><mxCell id="p04-_1" value="&lt;b&gt;04 云端识别作业：拼接器 · 两级队列 · 音频作业进程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1560" height="34" as="geometry"/></mxCell><mxCell id="p04-_2" value="一个作业进程在内存里跑完 G2–G5（D37），落盘后音频进入删除链。作业的切分（plan）一经冻结不变，执行配置（exec）可按代次换（D80）。" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1560" height="22" as="geometry"/></mxCell><mxCell id="p04-n-phone" value="&lt;b&gt;手机 App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;见 02 / 03&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="150" height="56" as="geometry"/></mxCell><UserObject label="&lt;b&gt;接入网关&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;prepare / commit · chunk_id 幂等 → chunk.stored&lt;/span&gt;" link="platform.html#s5-11" id="p04-n-j01"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="260" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;短期音频桶&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;加密直传；识别完即删 · 72 h 强删&lt;/span&gt;" link="platform.html#s5-12" id="p04-n-j02"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="400" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;拼接器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;在 ≥1 s 的 L1 丢弃区切，≤10 min；否则取暂定边界&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p04-n-j03"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="255" y="260" width="220" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;覆盖账 · 读依赖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;整帧 outcome；闭合且无读依赖才可删&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p04-n-j04"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="255" y="400" width="220" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;尾部等待 TailHold&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≤1 个窗口；常规最多等 20 min&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p04-n-j05"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="255" y="490" width="220" height="66" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;作业记录 RecJob&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;plan 冻结；exec / exec_gen 可换代&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p04-n-j07"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="525" y="400" width="210" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;两级队列&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;sync 按最早截止；regular 按最晚开始&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p04-n-j06"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="525" y="260" width="210" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;租约 · 防护令牌&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;120 s，心跳 30 s；lease_epoch 拒旧提交&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p04-n-j08"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="525" y="160" width="210" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;删除服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;② 删除对象并确认不存在 → ③ 回执&lt;/span&gt;" link="platform.html#s5-14" id="p04-n-j21"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="255" y="640" width="220" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;热词服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;BuildBias：每窗一张偏置表（见 05）&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p04-n-j19"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="525" y="640" width="210" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;解码&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;按 runs 解 Ogg Opus · 裁 pre_skip · 缺尾补零&lt;/span&gt;" link="design-asr.html#dd-g2" id="p04-n-j09"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;VAD 复核&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;中值 50 ms · 滞回 0.60 / 0.35&lt;/span&gt;" link="design-asr.html#dd-g2" id="p04-n-j10"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="160" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;识别窗口切分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≥300 ms 停顿处切 · 15–45 s&lt;/span&gt;" link="design-asr.html#dd-g2" id="p04-n-j11"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1165" y="160" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;播放检测&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;3 s 窗 · LFCC · 只打标签&lt;/span&gt;" link="design-asr.html#dd-g3" id="p04-n-j12"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="300" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;健康检查&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;文本规则 → 交叉 → pass / flag / quarantine / reject&lt;/span&gt;" link="design-asr.html#dd-g4" id="p04-n-j13"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1165" y="300" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;机主判定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;作业内；见 05&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p04-n-j20"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="985" y="470" width="150" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;落盘 ①&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;PersistResult：片段、覆盖、簇同一事务&lt;/span&gt;" link="design-asr.html#dd-jobs" id="p04-n-j14"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1165" y="620" width="150" height="80" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;CPU 小模型&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;VAD · 回放 · 事件 · 嵌入 · 重叠&lt;/span&gt;" link="platform.html#s5-13" id="p04-n-j15"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1365" y="160" width="200" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;8B 转写&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;每窗一次 · 带偏置表 · 束宽 8&lt;/span&gt;" link="design-asr.html#dd-8b" id="p04-n-j16"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1365" y="300" width="200" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;600M 对齐 · 支持&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;全量 CTC 强制对齐 · g_frame&lt;/span&gt;" link="design-asr.html#dd-g4" id="p04-n-j17"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1365" y="440" width="200" height="70" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;600M 交叉解码&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;可疑约 20% · 不带偏置&lt;/span&gt;" link="design-asr.html#dd-g4" id="p04-n-j18"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1365" y="580" width="200" height="70" as="geometry"/></mxCell></UserObject><mxCell id="p04-_28" value="&lt;b style=&quot;font-size:13px&quot;&gt;关键数据结构（design-asr.html#dd-jobs）&lt;/b&gt;&lt;br&gt;&lt;b&gt;RecJob&lt;/b&gt;：job_id = 内容哈希 · input_ranges · plan（冻结）· exec · exec_gen · final_release · state · lease_epoch · erasure_epoch&lt;br&gt;&lt;b&gt;plan&lt;/b&gt;：commit_ranges · windows[win_id, core, read] · read_ranges · tail_hold_id? · plan_version&lt;br&gt;&lt;b&gt;ExecConfig&lt;/b&gt;：primary_asr 8b | 600m · bias · bias_tables[win_id, bias_snapshot, entries] · alignment_source · crosscheck&lt;br&gt;&lt;b&gt;TailHold&lt;/b&gt;：ranges · context_read_ranges · release_at_ms · force_release · queue_class · visible_deadline_ms · waiting / assigned / cancelled&lt;br&gt;&lt;b&gt;CoverageEntry / ReadDependency&lt;/b&gt;：chunk_id · 整帧区间 · outcome（6 种）／ holder · read_ranges · active / released&lt;br&gt;&lt;b&gt;CommitPlan&lt;/b&gt;：lease_epoch · exec_gen · erasure_epoch · commit / tail ranges · windows · read_deps；已冻结则返回既有计划&lt;br&gt;&lt;b&gt;RebindExec&lt;/b&gt;：request_id · job_id · expected_exec_gen · changes（只合并涉及的维度）· reason；exec_gen +1，旧租约作废&lt;br&gt;&lt;b&gt;PersistResult&lt;/b&gt;：lease_epoch · exec_gen · bias_table_refs · erasure_epoch · segments · coverage · cluster_updates" style="html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;spacing=4;rounded=1;arcSize=4;strokeColor=#bdbdbd;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="880" height="400" as="geometry"/></mxCell><mxCell id="p04-_29" value="参数：单作业 ≤10 min · 截止：常规为录音结束 +3 h，同步为上传完成 +10 min · 同用户并行 2、同步预留约 25% · 失败 48 h、强删 72 h（从首次上传算）· 重试从 5 s 起指数退避、封顶 5 min · 8B 偏置 ≤300 条、2048 token · 8B 阻塞 &amp;gt;12 h 降级为 600M 主识别（RebindExec 换代）。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1175" width="880" height="100" as="geometry"/></mxCell><mxCell id="p04-n-q" value="queued" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="810" width="90" height="36" as="geometry"/></mxCell><mxCell id="p04-n-r" value="running" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1110" y="810" width="90" height="36" as="geometry"/></mxCell><mxCell id="p04-n-pl" value="planned" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1280" y="810" width="90" height="36" as="geometry"/></mxCell><mxCell id="p04-n-ps" value="persisted" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1450" y="810" width="110" height="36" as="geometry"/></mxCell><mxCell id="p04-n-rw" value="retry_wait" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1110" y="930" width="90" height="36" as="geometry"/></mxCell><mxCell id="p04-n-ft" value="failed_terminal" s