ze=1;whiteSpace=wrap;html=1;fillColor=#f6f1f8;strokeColor=#9673a6;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="140" width="290" height="650" as="geometry"/></mxCell><mxCell id="p01-_7" value="yanshi 边界" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;verticalAlign=top;align=center;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1360" y="140" width="220" height="650" as="geometry"/></mxCell><mxCell id="p01-_8" value="虚线框内需要音频 · G5 后识别结果落盘、删除音频" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcf0f0;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#b85450;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="545" y="180" width="470" height="320" as="geometry"/></mxCell><mxCell id="p01-_9" value="跨段存储" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6ec;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=14;fontColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1320" height="170" as="geometry"/></mxCell><mxCell id="p01-_1" value="&lt;b&gt;01 全局总览：领夹 → 手机 → 云端 → 下游&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1560" height="34" as="geometry"/></mxCell><mxCell id="p01-_2" value="主流从左到右；删除服务发回执与清除命令给手机，手机再把 ACK 水位与清除命令交给领夹（灰色虚线）；下方是跨段存储。节点可点击进入详设。" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1560" height="22" as="geometry"/></mxCell><UserObject label="&lt;b&gt;拾音&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;一期全量录音；二期启用 VAD 门控&lt;/span&gt;" link="device.html#s3" id="p01-n-a1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="190" width="190" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;编码与缓冲&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;Opus 16 kb/s · Flash 加密&lt;/span&gt;" link="design-device.html#dd-link" id="p01-n-a2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="300" width="190" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;BLE 突发传输&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;回执后立即擦除&lt;/span&gt;" link="design-device.html#dd-link" id="p01-n-a3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="35" y="410" width="190" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;接收 · 暂存 · 时钟&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;帧序号拼接 · 加密落盘&lt;/span&gt;" link="design-device.html#dd-timeline" id="p01-n-b1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="280" y="190" width="210" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;L1 拒识&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;只跑 VAD，丢弃非语音&lt;/span&gt;" link="design-device.html#dd-l1" id="p01-n-b2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="280" y="300" width="210" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;清单打包&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;场景快照 · L1 标签&lt;/span&gt;" link="design-device.html#dd-stage" id="p01-n-b3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="280" y="410" width="210" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;批量上传调度&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;≥30 分钟 · 2 小时 · 立即同步&lt;/span&gt;" link="design-device.html#dd-stage" id="p01-n-b4"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="280" y="520" width="210" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;VAD 复核&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;解码 · 切识别窗口&lt;/span&gt;" link="design-asr.html#dd-g2" id="p01-n-c1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555" y="220" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;播放检测&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;只打标签&lt;/span&gt;" link="design-asr.html#dd-g3" id="p01-n-c2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555" y="330" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;纠错候选召回&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;音系召回 · 声学评分（G5 前）&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p01-n-c9"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555" y="420" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;8B 转写&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;全量 · 热词偏置&lt;/span&gt;" link="design-asr.html#dd-8b" id="p01-n-c3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="835" y="220" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;幻觉检查&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;600M 交叉校验&lt;/span&gt;" link="design-asr.html#dd-g4" id="p01-n-c4"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="835" y="330" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;机主判定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;声纹比对 · 簇证据&lt;/span&gt;" link="design-speaker.html#dd-g5" id="p01-n-c5"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="835" y="420" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;相关性&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;降级或标背景&lt;/span&gt;" link="design-text.html#dd-g6" id="p01-n-c6"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="835" y="530" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;专名纠错&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;重排 · 闭集 diff · 只改显示&lt;/span&gt;" link="design-speaker.html#dd-fix" id="p01-n-c7"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="835" y="620" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;三档裁决&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;接受 · 隔离 · 拒绝&lt;/span&gt;" link="design-text.html#dd-g7" id="p01-n-c8"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="835" y="710" width="170" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;App 时间线&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;接受：正常显示 · 隔离：折叠、可放回&lt;/span&gt;" link="text.html#s5-down" id="p01-n-d1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1070" y="190" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;写入转写库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;接受档 · 隔离档；拒绝档只留时长&lt;/span&gt;" link="design-text.html#dd-g7" id="p01-n-d2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1070" y="320" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;对话单元&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;会议 · 10 分钟静默&lt;/span&gt;" link="design-text.html#dd-unit" id="p01-n-d3"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1070" y="440" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;入库闸门&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;逐字段核验 · 溯源&lt;/span&gt;" link="design-text.html#dd-g8" id="p01-n-d4"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1070" y="560" width="250" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;纪要 · 待办 · 记忆&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;只读接受档；隔离只占位&lt;/span&gt;" link="design-text.html#dd-g8" id="p01-n-d5"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1070" y="680" width="250" height="64" as="geometry"/></mxCell></UserObject><mxCell id="p01-_31" value="只收文字：佩戴者的话算用户原话，他人的话算外部内容，按结构化说话人字段区分（ADR-0036 / 0050）。&lt;br&gt;方案文档未细化这条接口，此列只标边界。" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff9c4;strokeColor=#c9b037;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1375" y="190" width="190" height="210" as="geometry"/></mxCell><UserObject label="&lt;b&gt;xinli 业务线&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;原文与派生在业务库&lt;/span&gt;" link="../../adr/0050-capture-text-in-the-business-line.md" id="p01-n-e1"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1375" y="680" width="190" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;内核 attested 页&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;结构化页 · 平台渲染&lt;/span&gt;" link="../../design/captures.md" id="p01-n-e2"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1375" y="540" width="190" height="64" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;声纹库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;加密 · 直到用户删除&lt;/span&gt;" link="design-speaker.html#dd-enroll" id="p01-n-s2"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="555" y="850" width="170" height="90" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;热词库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;个人 · 行业 · 公共&lt;/span&gt;" link="design-speaker.html#dd-hotlist" id="p01-n-s1"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="835" y="850" width="170" height="90" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;转写库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;接受档：按用户设置&lt;br&gt;隔离档：7 天自动删除&lt;/span&gt;" link="platform.html#s7" id="p01-n-s3"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;spacing=3;" vertex="1" parent="1"><mxGeometry x="1090" y="850" width="230" height="90" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;删除服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#333333&quot;&gt;判可删 · 擦除屏障 · 回执&lt;/span&gt;" link="design-text.html#dd-delete" id="p01-n-del"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="390" y="850" width="150" height="90" as="geometry"/></mxCell></UserObject><mxCell id="p01-_33" value="敏感数据只在三处长留：声纹库（加密）；转写库的文字；热词库里的个人词条。音频只在领夹 Flash、手机暂存与云端短期桶里短暂停留，删除链见 07 页。" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="330" height="120" as="geometry"/></mxCell><mxCell id="p01-_34" value="连线" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="820" width="220" height="22" as="geometry"/></mxCell><mxCell id="p01-_36" value="音频（敏感）" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1438" y="839" width="140" height="22" as="geometry"/></mxCell><mxCell id="p01-_38" value="文字" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1438" y="865" width="140" height="22" as="geometry"/></mxCell><mxCell id="p01-_40" value="控制 · 回执 · 擦除" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1438" y="891" width="140" height="22" as="geometry"/></mxCell><mxCell id="p01-_42" value="配置 · 模型读取" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" verte