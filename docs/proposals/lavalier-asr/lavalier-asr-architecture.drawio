<mxfile host="drawio" agent="yanshi-docs" version="24.7.17"><diagram id="p00" name="00 封面与图例"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p00-_36" value="需要音频" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcf0f0;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#b85450;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1250" y="420" width="128" height="60" as="geometry"/></mxCell><mxCell id="p00-_1" value="&lt;b&gt;领夹录音 ASR 方案 · 架构图&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=middle;fontColor=#222222;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1560" height="34" as="geometry"/></mxCell><mxCell id="p00-_2" value="对应 docs/proposals/lavalier-asr：index.html §2 总体架构、四份详设（device / asr / speaker / text）、platform.html §5–§7" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1560" height="22" as="geometry"/></mxCell><mxCell id="p00-_3" value="页面" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="700" height="26" as="geometry"/></mxCell><mxCell id="p00-_4" value="01 全局总览" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_5" value="领夹 → 手机 → 云端识别与判定 → 入库与下游 → yanshi 边界；G0–G8、跨段存储、回执与擦除回流" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="161" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_6" value="02 端侧：领夹 → 手机" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_7" value="采集与 Flash、密钥与擦除、BLE 链路、时间线与时钟、L1（G1）、暂存与上传（dd-link / timeline / l1 / stage）" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_8" value="03 链路时序" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_9" value="HELLO → CMD 清账 → RESUME → DATA → ACK 水位落盘 → zeroize；上传、云端回执与 ack-local（D81）" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="289" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_10" value="04 云端识别作业" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_11" value="拼接器、两级队列、RecJob（冻结 plan + 可换代 exec，D80）、G2 解码与 VAD、G3、8B、600M 与 G4、作业状态机" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="353" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_12" value="05 机主判定与热词" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_13" value="声纹注册、G5 分段聚类与打分、日内簇、热词库与每窗偏置表、音系召回与专名纠错" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="417" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_14" value="06 文本流水线" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_15" value="base / display 两视图、acoustic_tier、G6 相关性、G7 三档、对话单元、G8 言语行为与核验、发布与溯源、承诺状态机" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="481" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_16" value="07 删除链与数据生命周期" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_17" value="各存储的保留期限与删除触发；云端回执、用户擦除、到期三条删除时序" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_18" value="08 云端识别与判定详图" style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="584" width="220" height="26" as="geometry"/></mxCell><mxCell id="p00-_19" value="按三个目标（标记无效语音、准确转写、识别说话人）展开 G2–G5 作业、落盘 ① 与 G6 / G7，以及每一步读写的存储" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="609" width="700" height="38" as="geometry"/></mxCell><mxCell id="p00-_20" value="读法：每个节点写名称、一行要点；左上角黑色圆标是闸门编号（G0–G8），右上角“二期”只用于路线明确标为后期的组件，右下角是决定该结构的关键决策编号。节点可点击，链接指向同目录详设页的锚点（与 HTML 同目录打开时有效）。数字只取详设与 index.html 已有的值；阈值类标“占位”的以评测留出集为准。" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="700" height="120" as="geometry"/></mxCell><mxCell id="p00-_21" value="图例" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="700" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgclip" value="&lt;b&gt;领夹&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="130" height="40" as="geometry"/></mxCell><mxCell id="p00-_22" value="领夹" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="965" y="148" width="280" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgphone" value="&lt;b&gt;手机&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="196" width="130" height="40" as="geometry"/></mxCell><mxCell id="p00-_23" value="手机 App" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="965" y="204" width="280" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgasr" value="&lt;b&gt;云端&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="252" width="130" height="40" as="geometry"/></mxCell><mxCell id="p00-_24" value="云端 · 识别与判定" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="965" y="260" width="280" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgtext" value="&lt;b&gt;云端&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="308" width="130" height="40" as="geometry"/></mxCell><mxCell id="p00-_25" value="云端 · 入库与下游" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="965" y="316" width="280" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgstore" value="&lt;b&gt;跨段存储&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=3;" vertex="1" parent="1"><mxGeometry x="820" y="364" width="130" height="40" as="geometry"/></mxCell><mxCell id="p00-_26" value="跨段存储" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="965" y="372" width="280" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgext" value="&lt;b&gt;外部&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="130" height="40" as="geometry"/></mxCell><mxCell id="p00-_27" value="外部 / 边界（yanshi 内核、业务线）" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="965" y="428" width="280" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lggate" value="&lt;b&gt;某闸门&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1258" y="150" width="120" height="40" as="geometry"/></mxCell><mxCell id="p00-_29" value="闸门编号" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1390" y="154" width="200" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lglock" value="&lt;b&gt;敏感数据&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1250" y="216" width="128" height="40" as="geometry"/></mxCell><mxCell id="p00-_31" value="锁形 = 音频、密钥或声纹" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1390" y="222" width="200" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgp2" value="&lt;b&gt;后期组件&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="1250" y="286" width="128" height="40" as="geometry"/></mxCell><mxCell id="p00-_33" value="二期（虚线框）" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1390" y="292" width="200" height="26" as="geometry"/></mxCell><mxCell id="p00-n-lgd" value="&lt;b&gt;关键结构&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1250" y="346" width="128" height="44" as="geometry"/></mxCell><mxCell id="p00-_35" value="决策编号（index §12）" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1390" y="356" width="200" height="26" as="geometry"/></mxCell><mxCell id="p00-_37" value="虚线红框：需要音频的区域" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="1390" y="436" width="200" height="26" as="geometry"/></mxCell><mxCell id="p00-_38" value="连线" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="500" width="330" height="22" as="geometry"/></mxCell><mxCell id="p00-_40" value="音频（敏感）" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="898" y="519" width="250" height="22" as="geometry"/></mxCell><mxCell id="p00-_42" value="文字" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="898" y="545" width="250" height="22" as="geometry"/></mxCell><mxCell id="p00-_44" value="控制 · 回执 · 擦除" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="898" y="571" width="250" height="22" as="geometry"/></mxCell><mxCell id="p00-_46" value="配置 · 模型读取" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="898" y="597" width="250" height="22" as="geometry"/></mxCell><mxCell id="p00-_47" value="时序图（03、07 右侧）：竖虚线是参与方生命线，箭头上方是消息与关键字段，最右列是落盘或状态变化；同一参与方的自操作画成生命线旁的浅色块。" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;spacing=4;" vertex="1" parent="1"><mxGeometry x="820" y="640" width="700" height="80" as="geometry"/></mxCell><mxCell id="p00-_48" value="生成：2026-11-08，依据 main 上 46f2a33 的设计文档。改设计时同步改图。" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;f